    expected |= set(generated_toast.values())
    if state in {STATE_REQUESTS, NOTIFICATIONS, DELIVERY, OUTBOX, MANAGEMENT, RELEASE_APPROVALS, WEB_LAUNCH, STATE_AVAILABILITY}:
        expected |= {tuple(edge) for edge in REQUEST_EDGES}

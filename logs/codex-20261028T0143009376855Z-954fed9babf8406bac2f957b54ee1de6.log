status = subprocess.check_output(['git', 'status', '--short', '--untracked-files=all'], text=True)
index_path = root / '.git/index'
paths = set(manifest['framework']) | {r['file'] for r in manifest['revisions']} | {'migrations/manifest.json', 'tests/test_notification_management_migration.py', 'docs/WORKFLOW.md', 'docs/WEBSITE_PLAN.md'}
for line in status.splitlines():
    path = line[3:]
    if (root / path).is_file():
        paths.add(path)
evidence_dirs = sorted(p for p in (root / '.pytest_cache').glob('wu3-*') if p.is_dir())
for directory in evidence_dirs:
    paths.update(p.relative_to(root).as_posix() for p in directory.rglob('*') if p.is_file())
def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()
baseline = {'git_status': status, 'git_index_sha256': sha(index_path), 'files': {name: sha(root / name) for name in sorted(paths)}, 'historical_evidence_directories': [p.relative_to(root).as_posix() for p in evidence_dirs], 'manifest': manifest}
evidence = root / '.pytest_cache' / ('wu3-dependency-expectations-' + datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ'))
evidence.mkdir(exist_ok=False)
(evidence / 'baseline.json').write_text(json.dumps(baseline, indent=2) + '\\n', encoding='utf-8')
for name in ('oaf_website/state_availability_schema.py', 'oaf_website/migration_validation.py', 'tests/test_notification_management_migration.py', 'migrations/manifest.json'):
    dest = evidence / 'before' / name
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_bytes((root / name).read_bytes())
print(json.dumps({'evidence_directory': str(evidence), 'preserved_files': len(paths), 'historical_evidence_directories': baseline['historical_evidence_directories'], 'git_index_sha256': baseline['git_index_sha256']}))

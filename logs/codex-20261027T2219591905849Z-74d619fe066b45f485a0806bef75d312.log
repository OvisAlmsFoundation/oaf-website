+        stream.write(text);stream.flush();os.fsync(stream.fileno())
+b=read(F/'preparation-baseline.json')
+changed=[Path(name) for name,h in b['protected_project'].items() if digest(Path(name).read_bytes())!=h]
+assert len(changed)==1 and changed[0].parent==ROOT/'logs'
+path=changed[0];data=path.read_bytes();expected=b['protected_project'][str(path)]
+hasher=hashlib.sha256();length=0;found=None
+for line in data.splitlines(keepends=True):
+    hasher.update(line);length+=len(line)
+    if hasher.hexdigest()==expected:
+        found=length;break
+assert found is not None and len(data)>found,'original_owner_log_prefix_not_preserved'
+proof=dict(path=str(path),original_prefix_bytes=found,original_prefix_sha256=expected,
+           observed_bytes=len(data),observed_sha256=digest(data),status='PASS',preservation='original bytes retained; active parent log appended',
+           failure_record='finalization.log',failed_predicate='immutable_hash_of_active_parent_log',
+           remedy='retain original baseline; record active append-only log separately from immutable source/audit inventory')

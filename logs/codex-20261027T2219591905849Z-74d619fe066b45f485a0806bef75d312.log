class Stop(RuntimeError): pass
def require(ok, code):
    if not ok: raise Stop(code)
def emit(text): print(text, flush=True)
def begin(name):
    global stage
    stage = name; reached.append(name)
    emit('STARTED | UTC=' + datetime.now(timezone.utc).isoformat() + ' | run=' + RUN + ' | stage=' + name + ' | source=Invoke-Testing0008Upgrade.ps1/embedded_python')
def passed(detail): emit('PASS | ' + stage + ' | ' + detail)
def sha(data): return hashlib.sha256(data).hexdigest()
def encoded(record): return (json.dumps(record, sort_keys=True, indent=2, allow_nan=False) + '\n').encode('utf-8')
def safe(path):
    require(path.is_absolute() and path.resolve() == path and all(not p.is_symlink() and not (p.stat().st_file_attributes & 0x400) for p in (path, *path.parents)), 'missing_or_redirected_path')
def normalized(path):
    safe(path); text = path.read_bytes().decode('utf-8').replace('\r\n', '\n')
    require('\r' not in text and not text.startswith('\ufeff'), 'invalid_text_normalization')
    return sha(text.encode('utf-8'))
def snapshot():
    safe(AUDIT); result = {}
    for p in AUDIT.iterdir():
        safe(p); require(p.is_file(), 'unexpected_audit_directory'); result[p.name] = sha(p.read_bytes())
    return result
def preserve_previous():
    after = snapshot()
    require(all(after.get(k) == v for k, v in before.items()), 'historical_audit_changed_or_missing')
    require(all(sha(p.read_bytes()) == h for p, h in protected.items()), 'protected_project_or_index_changed')
    return after
def command(module, args): return [str(ROOT / '.venv/Scripts/python.exe'), '-B', '-u', '-m', module, *args]

    $script:taskLines.Add($Line)
    if ($null -eq $script:taskWriter) { throw 'live_log_unavailable' }
    $script:taskWriter.WriteLine($Line); $script:taskWriter.Flush(); $script:taskWriter.BaseStream.Flush($true)
}
try {
    $taskStream = New-Object IO.FileStream($taskLog, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::Read)
    $taskWriter = New-Object IO.StreamWriter($taskStream, (New-Object Text.UTF8Encoding($false)))
    Write-TaskLine ('STARTED | UTC=' + [DateTime]::UtcNow.ToString('o') + ' | run=' + $taskRunId + ' | source=' + $PSCommandPath + ' | log=' + $taskLog)
    Write-TaskLine 'PASS | reporting_initialization | exclusive flushed log; final clipboard and visual delivery delegated solely to Invoke-OAFCodex'
    $taskPhase = 'owner_environment'
    Write-TaskLine ('STARTED | ' + $taskPhase + ' | expected=exact OAF repository, Windows PowerShell 5.1 Desktop, OAF owner and audit destination')
    if ($PWD.ProviderPath -ine $taskRoot -or $PSScriptRoot -ine (Join-Path $taskRoot '.pytest_cache\wu2-testing-0008-v1') -or
        $PSVersionTable.PSEdition -ne 'Desktop' -or $PSVersionTable.PSVersion.Major -ne 5 -or $PSVersionTable.PSVersion.Minor -ne 1) { throw 'wrong_repository_or_powershell' }
    foreach ($taskPath in @($taskRoot, (Join-Path $taskRoot '.pytest_cache'), $PSScriptRoot, $taskAudit)) {
        if (((Get-Item -LiteralPath $taskPath).Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw 'redirected_path' }
    }
    $taskIdentity = [Security.Principal.WindowsIdentity]::GetCurrent()
    Write-TaskLine ('OBSERVED | owner_environment | account=' + $taskIdentity.Name + ' | SID=' + $taskIdentity.User.Value)
    if (-not $ValidateOnly) {
        if ($taskIdentity.Name -ine 'OAF-DELL5511\ovisa' -or $taskIdentity.User.Value -cne 'S-1-5-21-1444477859-3413144133-3443176940-1002' -or
            (Get-Acl -LiteralPath $taskAudit).Owner -ine $taskIdentity.Name) { throw 'owner_account_sid_and_audit_ownership_required_sandbox_execution_prohibited' }
        Write-TaskLine ('PASS | owner_environment | owner=' + $taskIdentity.Name + ' | SID=' + $taskIdentity.User.Value)
        Write-TaskLine 'OWNER_INTENT | This deliberate owner invocation adopts the six displayed safeguard categories for TESTING 0007_release_approvals to 0008_web_launch at exact Claim 11 and recorded artifact approval 27d41da5-63dd-4ad8-bb4b-36eda8cb4a10. Create one prerequisite approval, issue one single-use authorization and execute one upgrade. Require applied_and_verified with confirmed commit, postcommit catalog/ownership/ACL validation and published cleanup/completion. No new independent certification is asserted. Notification processing remains OFF.'
        # Reuse the existing owner approval workflow mutex; authority claim slots remain authoritative.
        $taskMutex = New-Object Threading.Mutex($false, 'Global\OAF_R47_Formal_Approvals')
        try { $taskHeld = $taskMutex.WaitOne(0) } catch [Threading.AbandonedMutexException] { $taskHeld = $true; throw 'interrupted_owner_workflow_inspect_readonly_no_retry' }
        if (-not $taskHeld) { throw 'existing_owner_workflow_active' }
    } else {
        Write-TaskLine ('PASS | offline_environment | observed_account=' + $taskIdentity.Name + ' | owner execution gate NOT_RUN; read-only preparation only')
    }
    $taskPhase = 'native_procedure'
    Write-TaskLine ('STARTED | ' + $taskPhase)
    $taskCode = @'

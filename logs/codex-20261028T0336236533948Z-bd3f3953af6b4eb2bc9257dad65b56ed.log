        for name in STAGES[3:]: emit('NOT_RUN | ' + name + ' | dependency=deliberate owner invocation; offline execution boundary')
        emit('RESULT | OFFLINE_VALIDATED'); return
    # The Windows owner/SID/ACL check and explicit OWNER_INTENT precede this process.
    begin('prerequisite_record')
    a._save(SOURCE.parent / (RUN + '-preservation-before.json'), dict(before_audit=before, protected_project={str(p): h for p, h in protected.items()}, request=SCOPE, artifact_approval=ARTIFACT, predecessor=PREDECESSOR))
    require(preserve_previous() == before and a._previous(AUDIT, 'development') == PREDECESSOR, 'state_changed_before_prerequisite')
    prerequisite = dict(format=1, kind='prerequisite_approval', id=str(uuid4()), reviewer_id=REVIEWER, approved_utc=a._now().isoformat(), decision='approved', environment='development', expected_start=SCOPE['expected_start'], approvals=dict(prior['approvals']), predecessor=PREDECESSOR, owner_reconciliation='not_applicable', testing_validation_run=TESTING_RUN)
    a._approval(prerequisite, 'prerequisite_approval', {'id': prerequisite['id']}, {'environment', 'expected_start', 'approvals', 'predecessor', 'owner_reconciliation', 'testing_validation_run'}, a._now())
    prerequisite_ref = {'id': prerequisite['id'], 'sha256': sha(encoded(prerequisite))}
    path = AUDIT / ('prerequisite-approval-' + prerequisite['id'] + '.json')
    emit('PLANNED | ' + path.name + ' | exact_sha256=' + prerequisite_ref['sha256'] + ' | artifact_approval=' + ARTIFACT['id'] + ' | predecessor=7 | testing_validation_run=' + TESTING_RUN)
    a._save(path, prerequisite)  # Existing exclusive writer, flush, fsync; once only.
    require(a._reference(AUDIT, 'prerequisite-approval', prerequisite_ref) == prerequisite, 'prerequisite_readback_differs')
    a._approvals(AUDIT, SCOPE, ARTIFACT, prerequisite_ref, PREDECESSOR, a._now())
    spec = dict(request=SCOPE, artifact_approval=ARTIFACT, prerequisite_approval=prerequisite_ref, expires_utc=(a._now() + timedelta(hours=1)).isoformat())
    spec_path = SOURCE.parent / (RUN + '-specification.json')
    a._save(spec_path, spec)
    require(a._read(spec_path)[0] == spec and spec_path.read_bytes() == encoded(spec), 'specification_readback_differs')
    passed('one prerequisite saved/read back; exact 0008 artifacts, DEVELOPMENT Claim 7 and accepted TESTING Claim 12 bound in issuer specification; ' + str(spec_path))
    begin('issuer_once')
    require(a._previous(AUDIT, 'development') == PREDECESSOR, 'predecessor_changed_before_issuer')
    issuer_exit, issued = child_json(command('oaf_website.migration_authority', ['issue', '--specification', str(spec_path), '--owner-issue']), 'issuer')
    require(issuer_exit == 0 and issued.get('outcome') == 'issued' and a._uuid(issued.get('authorization_id')), 'issuer_not_confirmed_no_reissue')
    authority_id = issued['authorization_id']
    passed('one issuer call completed; authorization=' + authority_id)
    begin('authorization_readback')
    auth, auth_hash = a._authorization(AUDIT, authority_id)
    require(auth['request'] == SCOPE and auth['artifact_approval'] == ARTIFACT and auth['prerequisite_approval'] == prerequisite_ref and auth['predecessor'] == PREDECESSOR and auth['expires_utc'] == spec['expires_utc'], 'issued_scope_binding_differs')
    issued_utc, expiry = a._utc(auth['issued_utc']), a._utc(auth['expires_utc'])
    require(issued_utc <= a._now() < expiry <= issued_utc + timedelta(hours=24), 'authorization_validity_invalid')
    a._approvals(AUDIT, SCOPE, ARTIFACT, prerequisite_ref, PREDECESSOR, issued_utc)
    require(a._previous(AUDIT, 'development') == PREDECESSOR, 'predecessor_changed_before_runner')
    preserve_previous()
    passed('published issuance, exact scope/approvals/predecessor/UTC validity; sha256=' + auth_hash)
    begin('migration_once')
    migration_exit, migration_result = child_json(command('oaf_website.migrate', migration_args(authority_id)), 'runner')
    require(migration_exit == 0, 'runner_nonzero_preserve_evidence_no_retry')
    passed('one existing CLI invocation returned zero; independent evidence validation follows')
    begin('applied_and_verified_evidence')
    claim_path = AUDIT / 'claim-development-00000008.json'
    new_claim, new_claim_hash = a._read(claim_path)
    require(new_claim['authorization_id'] == authority_id and new_claim['authorization_sha256'] == auth_hash and new_claim['request'] == SCOPE and new_claim['predecessor'] == PREDECESSOR and new_claim['run_id'] == migration_result['run_id'], 'new_claim_binding_differs')
    event, history = a._completed_run(AUDIT, claim_path)
    verify_applied(migration_result, event, history)

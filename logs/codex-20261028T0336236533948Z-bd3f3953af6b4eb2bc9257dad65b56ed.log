STAGES = ('artifact_dependencies', 'existing_approvals_predecessor', 'duplicate_and_preservation', 'prerequisite_record', 'issuer_once', 'authorization_readback', 'migration_once', 'applied_and_verified_evidence', 'preservation')
stage = STAGES[0]
reached = []
authority_id = None
migration_result = None
issuer_exit = None
migration_exit = None
before = None
protected = None
class Stop(RuntimeError): pass
def require(ok, code):
    if not ok: raise Stop(code)
def emit(text): print(text, flush=True)
def begin(name):
    global stage
    stage = name; reached.append(name)
    emit('STARTED | UTC=' + datetime.now(timezone.utc).isoformat() + ' | run=' + RUN + ' | stage=' + name + ' | source=Invoke-Development0008Upgrade.ps1/embedded_python')
def passed(detail): emit('PASS | ' + stage + ' | ' + detail)
def sha(data): return hashlib.sha256(data).hexdigest()
def encoded(record): return (json.dumps(record, sort_keys=True, indent=2, allow_nan=False) + '\n').encode('utf-8')
def safe(path):
    require(path.is_absolute() and path.resolve() == path and all(not p.is_symlink() and not (p.stat().st_file_attributes & 0x400) for p in (path, *path.parents)), 'missing_or_redirected_path')
def normalized(path):
    safe(path); text = path.read_bytes().decode('utf-8').replace('\r\n', '\n')
    require('\r' not in text and not text.startswith('\ufeff'), 'invalid_text_normalization')
    return sha(text.encode('utf-8'))
def snapshot():
    safe(AUDIT); result = {}
    for p in AUDIT.iterdir():
        safe(p); require(p.is_file(), 'unexpected_audit_directory'); result[p.name] = sha(p.read_bytes())
    return result
def preserve_previous():
    after = snapshot()
    require(all(after.get(k) == v for k, v in before.items()), 'historical_audit_changed_or_missing')
    require(all(sha(p.read_bytes()) == h for p, h in protected.items()), 'protected_project_or_index_changed')
    return after
def command(module, args): return [str(ROOT / '.venv/Scripts/python.exe'), '-B', '-u', '-m', module, *args]
def migration_args(identifier):
    return ['upgrade', '--environment', 'development', '--expected-start', SCOPE['expected_start'], '--target', SCOPE['target'], '--manifest-sha256', M, '--revision-sha256', R, '--authorization-id', identifier]
def child_json(argv, kind):
    # Both existing CLIs emit one bounded sanitized JSON object; never print raw stderr.
    child = subprocess.Popen(argv, cwd=ROOT, env=dict(os.environ), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    out, err = child.communicate()
    emit('NATIVE_EXIT | ' + kind + ' | ' + str(child.returncode))
    require(len(out) <= 64000 and len(err) <= 64000, kind + '_output_size_invalid')
    require(not err, kind + '_unexpected_stderr_suppressed')
    try: result = json.loads(out, object_pairs_hook=a._unique)
    except (ValueError, UnicodeError): raise Stop(kind + '_json_unavailable')
    require(type(result) is dict, kind + '_json_not_object')
    if kind == 'issuer':
        require(set(result) in ({'outcome', 'authorization_id'}, {'outcome', 'classification'}), 'issuer_result_fields_invalid')
        require(result.get('outcome') in {'issued', 'denied'}, 'issuer_outcome_invalid')
        require(result.get('authorization_id') is None or a._uuid(result['authorization_id']), 'issuer_uuid_invalid')
        require(result.get('classification') is None or result['classification'] == mc.Failure.OPERATIONAL_GATE, 'issuer_classification_invalid')
    else:
        # Validate against the runner's existing result contract, even on nonzero exit.
        allowed = set(m._Evidence(m.Request(**SCOPE), mc.IDENTITIES['development'], str(uuid4())).result('pending', None))
        require(set(result) <= allowed | {'secondary_failure'}, 'runner_result_fields_invalid')
        require(result.get('outcome') in {'applied_and_verified', 'failed'}, 'runner_outcome_invalid')
        require(result.get('run_id') is None or a._uuid(result['run_id']), 'runner_run_id_invalid')
        for key in ('classification', 'failed_phase', 'commit_certainty', 'interruption_phase', 'lock_outcome', 'validation_outcome', 'audit_write_outcome', 'transaction_outcome', 'secondary_failure'):
            require(result.get(key) is None or result[key] in a._VALUES, 'runner_scalar_invalid')
        for key in ('mutation_started', 'database_commit_confirmed'):
            require(key not in result or type(result[key]) is bool, 'runner_boolean_invalid')
        for key in ('cleanup', 'cleanup_attempts'):
            if key in result:
                require(type(result[key]) is dict and set(result[key]) == a._COMPONENTS, 'runner_cleanup_fields_invalid')
                for value in result[key].values():
                    require((key == 'cleanup' and value in a._ATTEMPTS | {'not_attempted'}) or (key == 'cleanup_attempts' and type(value) is list and all(x in a._ATTEMPTS for x in value)), 'runner_cleanup_value_invalid')
        require(type(result.get('secondary_failures', [])) is list, 'runner_secondary_invalid')
        for failure in result.get('secondary_failures', []):
            require(type(failure) is dict and set(failure) == {'component', 'classification'} and failure['component'] in a._COMPONENTS | {'commit'} and failure['classification'] in a._VALUES, 'runner_secondary_value_invalid')
    emit('CHILD_RESULT | ' + kind + ' | ' + json.dumps(result, sort_keys=True))
    return child.returncode, result
def verify_applied(result, event, history):
    require(event['outcome'] == 'applied_and_verified' and event['failure'] is None and a._continuation_state(event, history) == SCOPE['target'], 'authoritative_applied_postconditions_not_complete')
    expected = dict(outcome='applied_and_verified', classification=None, failed_phase=None, interruption_phase=None, commit_certainty='confirmed', database_commit_confirmed=True, mutation_started=True, transaction_outcome='committed_confirmed', lock_outcome='release_confirmed', validation_outcome='postcommit_passed', audit_write_outcome='confirmed_successful', secondary_failures=[])
    require(all(result.get(k) == v for k, v in expected.items()), 'runner_applied_postconditions_differ')
    require(result['run_id'] == event['run_id'] and all(result['cleanup'][k] == 'confirmed_successful' for k in a._COMPONENTS), 'runner_cleanup_or_run_differs')
    for key in ('commit_certainty', 'database_commit_confirmed', 'mutation_started', 'transaction_outcome', 'lock_outcome', 'validation_outcome', 'audit_write_outcome', 'failed_phase', 'interruption_phase', 'secondary_failures'):
        require(result[key] == event[key], 'runner_published_terminal_disagreement')
    for key in a._COMPONENTS - {'audit_finalize'}:
        require(result['cleanup'][key] == event['cleanup'][key] and result['cleanup_attempts'][key] == event['cleanup_attempts'][key], 'runner_published_cleanup_disagreement')
    require(result['cleanup_attempts']['audit_finalize'] == ['confirmed_successful'], 'runner_finalization_not_acknowledged')
def interface_parser(module):
    # Reuse only the real main's parser construction; never execute its try/body.
    tree = ast.parse(Path(module.__file__).read_bytes())
    function = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == 'main')
    body = []
    for node in function.body:
        if isinstance(node, ast.Try): break
        body.append(node)
    namespace = {'_Parser': module._Parser}
    exec(compile(ast.Module(body=body, type_ignores=[]), module.__file__, 'exec'), namespace)
    return namespace['parser']
def main():
    global a, mc, m, before, protected, authority_id, migration_result, issuer_exit, migration_exit
    begin('artifact_dependencies')
    require(MODE in {'validate', 'owner'} and Path.cwd() == ROOT and Path(sys.executable) == ROOT / '.venv/Scripts/python.exe' and sys.version_info[:2] == (3, 11), 'wrong_mode_root_or_interpreter')
    require(Path(os.environ.get('LOCALAPPDATA', '')) / 'OAF Website/BootstrapAudit/MigrationAudit' == AUDIT, 'wrong_audit_destination')
    safe(SOURCE); safe(AUDIT)
    package = json.loads((SOURCE.parent / 'package.json').read_bytes())
    require(sha(SOURCE.read_bytes()) == package['source_sha256'], 'prepared_source_changed')
    for name, digest in package['dependencies'].items():
        path = Path(name); safe(path); require(sha(path.read_bytes()) == digest, 'prepared_dependency_changed')
    require(normalized(ROOT / 'migrations/manifest.json') == M and normalized(ROOT / 'migrations/versions/0008_web_launch.py') == R, 'approved_artifact_identity_changed')
    manifest = json.loads((ROOT / 'migrations/manifest.json').read_bytes())
    for name, digest in manifest['framework'].items(): require(normalized(ROOT / name) == digest, 'approved_framework_identity_changed')
    for name in ('requirements.txt', 'requirements-migrations.txt'):
        for line in (ROOT / name).read_text().splitlines():
            match = re.fullmatch(r'([A-Za-z0-9_-]+)(?:\[[^\]]+\])?==([^ ]+)', line.strip())
            if match: require(version(match[1]) == match[2], 'installed_dependency_pin_differs')
    require(os.environ.get('OAF_ENV') in {None, 'development'}, 'conflicting_oaf_environment')
    os.environ['OAF_ENV'] = 'development'  # Existing required explicit environment; child only.
    from oaf_website import migration_authority as a, migration_config as mc, migrate as m
    if MODE == 'validate':
        from oaf_website import database_config as dc
        def denied_operation(*args, **kwargs): raise Stop('offline_operational_boundary_prohibited')
        a._save = a.issue_authorization = a.audit_destination = denied_operation
        mc._windows_password = mc.load_migration_config = denied_operation
        dc._windows_password = dc.load_database_config = dc.load_testing_database_config = denied_operation
        m.load_migration_config = m.create_engine = m.run = denied_operation
    identity = mc.select_identity('development')
    require((identity.database, identity.migrator, identity.owner, identity.runtime, identity.host, identity.port, identity.postgres_major, identity.schema, identity.credential_service) == ('oaf_website_dev', 'oaf_website_dev_migrator', 'oaf_website_dev_schema_owner', 'oaf_website_app', '127.0.0.1', 5432, 17, 'oaf_website', 'OAF Website/development/PostgreSQL/Migrations'), 'development_identity_registry_differs')
    emit('IDENTITY | development | database=' + identity.database + ' | migrator=' + identity.migrator + ' | owner=' + identity.owner + ' | runtime=' + identity.runtime + ' | live verification=existing runner before mutation and postcommit')
    a._artifacts(m.Request(**SCOPE))
    passed('exact approved artifacts, manifest framework, installed pins and existing DEVELOPMENT configuration; no credentials read')
    begin('existing_approvals_predecessor')
    artifact = a._reference(AUDIT, 'artifact-approval', ARTIFACT)
    a._approval(artifact, 'artifact_approval', ARTIFACT, {'manifest_hash', 'revision_hash'}, a._now())
    require(artifact['reviewer_id'] == REVIEWER and artifact['manifest_hash'] == M and artifact['revision_hash'] == R, 'approved_record_differs')
    require(a._previous(AUDIT, 'development') == PREDECESSOR, 'latest_development_claim_not_exact_claim7')
    claim, claim_hash = a._read(AUDIT / 'claim-development-00000007.json')
    event, history = a._completed_run(AUDIT, AUDIT / 'claim-development-00000007.json')
    require(claim_hash == PREDECESSOR['sha256'] and claim['run_id'] == DEVELOPMENT_RUN and event['outcome'] == 'applied_and_verified' and event['failure'] is None and a._continuation_state(event, history) == SCOPE['expected_start'], 'claim7_completed_continuation_unproven')
    runner_parsed = interface_parser(m).parse_args(migration_args(claim['authorization_id']))
    require(vars(runner_parsed) == dict(action='upgrade', environment='development', expected_start=SCOPE['expected_start'], target=SCOPE['target'], manifest_sha256=M, revision_sha256=R, authorization_id=claim['authorization_id']), 'prepared_runner_arguments_differ')
    issuer_parsed = interface_parser(a).parse_args(['issue', '--specification', str(SOURCE.parent / (RUN + '-specification.json')), '--owner-issue'])
    require(issuer_parsed.action == 'issue' and issuer_parsed.owner_issue is True, 'prepared_issuer_arguments_differ')
    old_auth, _ = a._authorization(AUDIT, claim['authorization_id'])
    require(old_auth['prerequisite_approval'] == PRIOR, 'historical_prerequisite_reference_differs')
    prior = a._reference(AUDIT, 'prerequisite-approval', PRIOR)
    # Validate historical approval at issuance; the completed Claim 7 proves continuation.
    # Its old 0007 TESTING citation is retained as history; the accepted 0008 citation is required below.
    require(old_auth['id'] == claim['authorization_id'] == DEVELOPMENT_AUTHORIZATION['id'] and claim['authorization_sha256'] == DEVELOPMENT_AUTHORIZATION['sha256'], 'development_authorization_identity_differs')
    a._approval(prior, 'prerequisite_approval', PRIOR, {'environment', 'expected_start', 'approvals', 'predecessor', 'owner_reconciliation', 'testing_validation_run'}, a._utc(old_auth['issued_utc']))
    require(prior['environment'] == 'development' and prior['expected_start'] == claim['request']['expected_start'] and prior['predecessor'] == claim['predecessor'], 'historical_prerequisite_scope_differs')
    dev_proof = json.loads(Path(package['development_evidence']).read_bytes())
    dev_completion = json.loads(Path(package['development_completion']).read_bytes())
    require(dev_proof['claim'] == claim and dev_proof['claim_sha256'] == claim_hash and dev_proof['authorization_id'] == DEVELOPMENT_AUTHORIZATION['id'] and dev_proof['authorization_sha256'] == DEVELOPMENT_AUTHORIZATION['sha256'] and dev_proof['terminal_event'] == event and dev_proof['event_history'] == history, 'retained_development_evidence_differs')
    require(dev_completion['status'] == 'PASS' and dev_completion['outcome'] == 'APPLIED_AND_VERIFIED' and dev_completion['native_exit'] == 0 and dev_completion['log_readback'] and dev_completion['report_readback'] and dev_completion['first_failure'] is None, 'development_native_completion_unproven')
    require(dev_completion['source_sha256'] == dev_proof['procedure_sha256'] == package['development_source_sha256'] and dev_proof['request'] == claim['request'] and dev_proof['result']['run_id'] == DEVELOPMENT_RUN, 'development_completion_source_or_scope_differs')
    test_path = AUDIT / 'claim-testing-00000012.json'
    test_claim, test_hash = a._read(test_path)
    test_auth, test_auth_hash = a._authorization(AUDIT, TESTING_AUTHORIZATION['id'])
    test_event, test_history = a._completed_run(AUDIT, test_path)
    require(test_hash == TESTING_CLAIM['sha256'] and test_claim['run_id'] == TESTING_RUN and test_claim['authorization_id'] == TESTING_AUTHORIZATION['id'] and test_auth_hash == TESTING_AUTHORIZATION['sha256'] and test_auth['artifact_approval'] == ARTIFACT and test_claim['request'] == dict(SCOPE, environment='testing'), 'matching_testing_claim_or_authorization_differs')
    test_proof = json.loads(Path(package['testing_evidence']).read_bytes())
    test_completion = json.loads(Path(package['testing_completion']).read_bytes())
    require(test_proof['claim'] == test_claim and test_proof['claim_sha256'] == test_hash and test_proof['authorization_id'] == TESTING_AUTHORIZATION['id'] and test_proof['authorization_sha256'] == test_auth_hash and test_proof['terminal_event'] == test_event and test_proof['event_history'] == test_history, 'retained_testing_evidence_differs')
    require(test_completion['status'] == 'PASS' and test_completion['outcome'] == 'APPLIED_AND_VERIFIED' and test_completion['native_exit'] == 0 and test_completion['log_readback'] and test_completion['report_readback'] and test_completion['first_failure'] is None, 'testing_native_completion_unproven')
    require(test_completion['source_sha256'] == test_proof['procedure_sha256'] == package['testing_source_sha256'] and test_proof['request'] == test_claim['request'] and test_proof['artifact_approval'] == ARTIFACT, 'testing_completion_source_or_artifacts_differ')
    verify_applied(test_proof['result'], test_event, test_history)
    a._testing_validation(AUDIT, SCOPE, TESTING_RUN)
    att = a._reference(AUDIT, 'prerequisite-attestation', SAFEGUARD)
    require(prior['reviewer_id'] == att['reviewer_id'] == REVIEWER and att['id'] == SAFEGUARD['id'] and att['kind'] == 'prerequisite_applicability_attestation' and att['decision'] == 'approved' and set(att['categories']) == a.PREREQUISITES and prior['approvals'] == {k: SAFEGUARD['id'] for k in a.PREREQUISITES}, 'six_category_provenance_differs')
    require(set(APPLICABILITY) == a.PREREQUISITES, 'applicability_categories_differ')
    for category in sorted(a.PREREQUISITES):
        require(bool(att['categories'][category]['statement']) and att['categories'][category]['applicability'] == 'approved_for_exact_development_transition', 'historical_category_unapproved')
        emit('SAFEGUARD | ' + category + ' | reference=' + SAFEGUARD['id'] + ' | current_applicability=' + APPLICABILITY[category])
    passed('recorded 0008 artifact approval; exact DEVELOPMENT Claim 7 applied at 0007; accepted TESTING Claim 12 applied at 0008; six DEVELOPMENT safeguards explicitly applicable to this upgrade')
    begin('duplicate_and_preservation')
    before = snapshot()
    # Reuse the accepted TESTING preservation inventory; read current bytes without a Git operation.
    inventory = json.loads(Path(package['preservation_inventory']).read_bytes())
    protected = {Path(name): sha(Path(name).read_bytes()) for name in inventory['protected_project']}
    protected.update({Path(name): sha(Path(name).read_bytes()) for name in package['dependencies']})
    protected[SOURCE] = sha(SOURCE.read_bytes())
    for name in before:
        if name.startswith(('prerequisite-approval-', 'authorization-')):
            doc, _ = a._read(AUDIT / name)  # Malformed/partial record stops before any write.
            if name.startswith('prerequisite-approval-'):
                require(not (doc.get('environment') == 'development' and doc.get('expected_start') == SCOPE['expected_start'] and doc.get('predecessor') == PREDECESSOR), 'matching_prerequisite_exists_inspect_readonly_no_retry')
            else:
                require(not (doc.get('request', {}).get('environment') == 'development' and doc.get('predecessor') == PREDECESSOR), 'claim7_authorization_already_exists_inspect_readonly_no_reissue')

index 0000000000000000000000000000000000000000..9e9daffb2380b0c5ed28d53ed9d6bcdc116e6876
--- /dev/null
+++ b/.pytest_cache/wu3-development-0009-v1/validate-evidence.py
@@ -0,0 +1,153 @@
+"""Focused repository-only identity, publication and unchanged-control checks."""
+import ast
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import sys
+
+ROOT = Path.cwd()
+HERE = ROOT / '.pytest_cache/wu3-development-0009-v1'
+RESULT = HERE / 'evidence-validation.json'
+SOURCE = HERE / 'Invoke-Development0009Upgrade.ps1'
+platform.uname()
+
+def guard(event, args):
+    if event == 'open':
+        if isinstance(args[0], (str, bytes, os.PathLike)):
+            path = Path(os.fsdecode(args[0]))
+            assert 'MigrationAudit' not in path.parts and path.name != 'Microsoft.PowerShell_profile.ps1', 'external_audit_or_profile_access_prohibited'
+        if args[2] & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND):
+            assert isinstance(args[0], (str, bytes, os.PathLike)) and Path(args[0]) == RESULT, 'write_prohibited'
+    if (event.startswith('socket.') and event != 'socket.gethostname') or event in {'subprocess.Popen', 'os.mkdir', 'os.remove', 'os.rmdir', 'os.rename', 'os.link', 'os.symlink', 'os.truncate', 'os.chmod', 'os.utime', 'os.system'}:
+        raise RuntimeError('operational_boundary_prohibited')
+
+sys.addaudithook(guard)
+sys.path.insert(0, str(ROOT))
+from oaf_website import migration_authority as a, migration_config as mc, migrate as m, database_config as dc
+
+def denied(*args, **kwargs):
+    raise RuntimeError('live_operation_prohibited')
+
+a.issue_authorization = a._save = a.audit_destination = denied
+mc._windows_password = mc.load_migration_config = denied
+dc._windows_password = dc.load_database_config = dc.load_testing_database_config = denied
+m.load_migration_config = m.create_engine = m.run = denied
+sha = lambda data: hashlib.sha256(data).hexdigest()
+enc = lambda doc: (json.dumps(doc, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
+package = json.loads((HERE / 'package.json').read_bytes())
+assert sha(SOURCE.read_bytes()) == package['source_sha256']
+verified, deferred = [], []
+for name, digest in package['dependencies'].items():
+    path = Path(name)
+    if path.is_relative_to(ROOT):
+        assert sha(path.read_bytes()) == digest, name
+        verified.append(name)
+    else:
+        deferred.append(dict(path=name, sha256=digest))
+
+source = SOURCE.read_text()
+embedded = lambda text: text.split("    $taskCode = @'\n", 1)[1].split("\n'@", 1)[0]
+code = embedded(source)
+tree = ast.parse(code)
+compile(code, 'development_embedded_python', 'exec')
+oldsource = Path(package['reused_source']).read_text()
+oldcode = embedded(oldsource)
+functions = lambda value: {n.name: ast.dump(n) for n in ast.parse(value).body if isinstance(n, ast.FunctionDef) and n.name not in {'main', 'begin'}}
+assert functions(code) == functions(oldcode), 'helper_control_flow_changed'
+
+def normalize_outer(value, inner):
+    value = value.replace(inner, 'EMBEDDED_PYTHON').replace('wu3-development-0009-v1', 'wu2-development-0008-v1').replace('WU3 - DEVELOPMENT Migration 0009', 'WU2 - DEVELOPMENT Migration 0008')
+    return '\n'.join('OWNER_INTENT' if "Write-TaskLine 'OWNER_INTENT | " in line else line for line in value.splitlines() if not line.startswith('# Version '))
+
+assert normalize_outer(source, code) == normalize_outer(oldsource, oldcode), 'owner_security_lock_native_exit_logging_reporting_changed'
+definitions = []
+for node in tree.body:
+    if isinstance(node, ast.If): break
+    definitions.append(node)
+saved = sys.argv
+try:
+    sys.argv = ['embedded', 'validate', str(SOURCE), 'offline-static']
+    ns = {}
+    exec(compile(ast.Module(body=definitions, type_ignores=[]), 'embedded_definitions', 'exec'), ns)
+finally:
+    sys.argv = saved
+ns.update(a=a, mc=mc, m=m)
+assert ns['SCOPE'] == package['request']
+for key, name in [('ARTIFACT', 'artifact_approval'), ('PREDECESSOR', 'predecessor'), ('PRIOR', 'historical_prerequisite'), ('SAFEGUARD', 'safeguard_approval'), ('TESTING_CLAIM', 'testing_claim')]:
+    assert ns[key] == package[name]
+assert ns['TESTING_RUN'] == package['testing_validation_run']
+assert set(ns['APPLICABILITY']) == a.PREREQUISITES and len(a.PREREQUISITES) == 6
+a._artifacts(m.Request(**package['request']))
+identity = mc.select_identity('development', environ={'OAF_ENV': 'development'})
+assert (identity.database, identity.migrator, identity.owner, identity.runtime, identity.host, identity.port, identity.postgres_major, identity.schema, identity.credential_service) == ('oaf_website_dev', 'oaf_website_dev_migrator', 'oaf_website_dev_schema_owner', 'oaf_website_app', '127.0.0.1', 5432, 17, 'oaf_website', 'OAF Website/development/PostgreSQL/Migrations')
+identifier = '11111111-1111-4111-8111-111111111111'
+parsed = ns['interface_parser'](m).parse_args(ns['migration_args'](identifier))
+scope = package['request']
+assert vars(parsed) == dict(action='upgrade', environment='development', expected_start=scope['expected_start'], target=scope['target'], manifest_sha256=scope['manifest_hash'], revision_sha256=scope['revision_hash'], authorization_id=identifier)
+parsed = ns['interface_parser'](a).parse_args(['issue', '--specification', str(HERE / 'future-specification.json'), '--owner-issue'])
+assert parsed.owner_issue is True
+command = (HERE / 'owner-invocation.txt').read_text()
+assert package['source_sha256'] in command and sha((HERE / 'package.json').read_bytes()) in command and '& $taskSource' in command and '-ValidateOnly' not in command
+
+publication = []
+for environment, sequence in [('development', 8), ('testing', 14)]:
+    proof_path = Path(package[environment + '_evidence'])
+    completion_path = Path(package[environment + '_completion'])
+    run = proof_path.name.removesuffix('-verified-postconditions.json')
+    proof = json.loads(proof_path.read_bytes())
+    completion = json.loads(completion_path.read_bytes())
+    retained = json.loads((proof_path.parent / (run + '-preservation.json')).read_bytes())
+    after = retained['after_audit']
+    assert retained['retained'] is True
+    assert all(after.get(k) == v for k, v in retained['before_audit'].items())
+    assert completion['status'] == 'PASS' and completion['outcome'] == 'APPLIED_AND_VERIFIED' and completion['native_exit'] == 0 and completion['first_failure'] is None
+    assert completion['log_readback'] is True and completion['report_readback'] is True
+    assert sha(Path(package[environment + '_source']).read_bytes()) == completion['source_sha256'] == proof['procedure_sha256'] == package[environment + '_source_sha256']
+    claim = proof['claim']
+    assert proof['request'] == claim['request'] and claim['request']['environment'] == environment
+    assert claim['run_id'] == proof['result']['run_id'] and claim['authorization_id'] == proof['authorization_id'] and claim['authorization_sha256'] == proof['authorization_sha256']
+    assert claim['predecessor']['sequence'] == sequence - 1
+    claim_name = 'claim-' + environment + '-%08d.json' % sequence
+    assert sha(enc(claim)) == proof['claim_sha256'] == after[claim_name]
+    identifier, run_id = proof['authorization_id'], proof['result']['run_id']
+    evidence = {claim_name: proof['claim_sha256']}
+    for number, event in enumerate(proof['event_history'], 1):
+        name = 'event-' + run_id + '-%08d.json' % number
+        record = dict(format=1, kind='execution_event', sequence=number, authorization_id=identifier, event=event)
+        assert sha(enc(record)) == after[name], name
+        evidence[name] = after[name]
+    terminal_name = 'terminal-' + run_id + '.json'
+    terminal = dict(format=1, kind='execution_finalized', sequence=len(proof['event_history'])+1, authorization_id=identifier, event=proof['terminal_event'])
+    assert sha(enc(terminal)) == after[terminal_name]
+    for name, digest, marker_run, marker_evidence in [('authorization-' + identifier + '.json', proof['authorization_sha256'], None, {}), (terminal_name, after[terminal_name], run_id, evidence)]:
+        assert after[name] == digest
+        marker = dict(format=1, kind='record_completion', record=name, sha256=digest, authorization_id=identifier, run_id=marker_run, evidence=marker_evidence)
+        assert sha(enc(marker)) == after['pending-' + name] == after['completed-' + name], name
+    ns['SCOPE'] = proof['request']
+    ns['verify_applied'](proof['result'], proof['terminal_event'], proof['event_history'])
+    log = (proof_path.parent / (run + '.log')).read_text()
+    report = (proof_path.parent / (run + '-REPORT.txt')).read_text()
+    assert report.endswith(log.rstrip('\n')), 'retained_report_log_readback_differs'
+    for line in ('NATIVE_EXIT | issuer | 0', 'NATIVE_EXIT | runner | 0', 'NATIVE_EXIT | embedded_python | 0', 'RESULT | APPLIED_AND_VERIFIED'):
+        assert line in log.splitlines()
+    assert json.loads(next(line.removeprefix('CHILD_RESULT | runner | ') for line in log.splitlines() if line.startswith('CHILD_RESULT | runner | '))) == proof['result']
+    assert 'PASS | applied_and_verified_evidence | authoritative applied_and_verified;' in log
+    if environment == 'testing':
+        assert proof['request'] == dict(scope, environment='testing') and proof['artifact_approval'] == package['artifact_approval']
+        assert proof['result']['run_id'] == package['testing_validation_run']
+    else:
+        assert proof['request']['target'] == scope['expected_start'] and package['predecessor'] == dict(sequence=sequence, sha256=proof['claim_sha256'])
+    publication.append(dict(environment=environment, sequence=sequence, run_id=run_id, proof_sha256=sha(proof_path.read_bytes()), completion_sha256=sha(completion_path.read_bytes()), exact_event_and_terminal_hashes='PASS', published_completion_marker_hashes='PASS', native_completion_and_log_report='PASS'))
+
+# Reuse the corrected approval's repository publication report, without external access.
+approval_report = ROOT / '.pytest_cache/wu3-approve-corrected-0009-20261028T015824Z-bab7727f/owner-20261028T020117Z-a1b8a2a81850423b9e31eedccd37daba-REPORT.txt'
+text = approval_report.read_text()
+artifact_record = json.loads(text[text.index('{\n'):text.index('\nRESULT |')])
+assert sha(enc(artifact_record)) == package['artifact_approval']['sha256']
+assert artifact_record['id'] == package['artifact_approval']['id'] and artifact_record['manifest_hash'] == scope['manifest_hash'] and artifact_record['revision_hash'] == scope['revision_hash']
+result = dict(status='PASS', source_sha256=package['source_sha256'], repository_dependencies_verified=len(verified), external_dependencies_deferred=deferred, exact_artifact_approval='PASS', accepted_publication=publication, unchanged_helpers='PASS', unchanged_powershell_owner_lock_native_exit_logging_reporting='PASS', exact_existing_cli_parsers='PASS', six_categories='PASS', saved_command_binding='PASS', current_development_frontier='Required at future owner execution; not accessed offline', owner_procedure_invoked=False, real_prerequisites=0, real_authorizations=0, credential_access=0, database_access=0, accepted_campaigns_repeated=False)
+with RESULT.open('x', encoding='utf-8', newline='\n') as stream:
+    json.dump(result, stream, indent=2, sort_keys=True); stream.write('\n'); stream.flush(); os.fsync(stream.fileno())
+print(json.dumps(dict(status='PASS', repository_dependencies=len(verified), deferred_external_dependencies=len(deferred), exact_published_success_runs=len(publication), unchanged_controls='PASS')), flush=True)

SCOPE = dict(action='upgrade', environment='development', expected_start='0007_release_approvals', target='0008_web_launch', manifest_hash=M, revision_hash=R)
# These are fresh applicability statements adopted only by deliberate owner invocation.
# The historical attestation is retained with its original transition and exact bytes.
APPLICABILITY = {
    'dependency_acceptance': 'Reuse accepted Python 3.11 and exact installed requirement pins, recorded 0008 artifact approval and manifest-bound framework; accepted independent review is not repeated.',
    'bootstrap_validation': 'Reuse DEVELOPMENT PostgreSQL 17 at 127.0.0.1:5432, oaf_website_dev, authenticated oaf_website_dev_migrator, effective oaf_website_dev_schema_owner and runtime oaf_website_app. Existing runner must verify SCRAM, identity, memberships, authority, exact 0007 starting catalog, ownership and ACLs before mutation; historical completion is not current live verification.',
    'lock_and_timeouts': 'Reuse database-scoped session lock (0x4F414657,4), 5-second acquisition/query and lock timeouts, 60-second statement timeout, physical-session continuity and lock survival through setup rollback, one revision, commit and postcommit validation; retain existing authority rechecks.',
    'search_path_and_postconditions': 'Reuse pg_catalog, oaf_website, pg_temp under DEVELOPMENT schema owner; upgrade exactly 0007 to 0008. Retain existing 0001-0007 objects, ownership and ACLs and apply only the approved manifest-bound web_launch event constraint changes; no new tables or grants. Require exact 0008 catalog, constraints, indexes, generated types, FK triggers/dependencies, owners and matching runtime privileges without grant option. Require restrictive defaults, existing ACL checks and one exact alembic_version row before commit and independently postcommit while locked.',
    'recovery_procedure': 'Reuse published DEVELOPMENT Claim 7 applied_and_verified at 0007 and accepted TESTING Claim 12 applied_and_verified at 0008 with exact matching artifacts and published completion. Require actual current Claim 7 and complete published continuation evidence at execution time before owner_reconciliation=not_applicable. Preserve every prior claim and failure. Stop on any stale, partial, uncertain or contradictory evidence, nonzero native exit, unconfirmed commit, postcommit failure, cleanup or audit failure. No automatic retry, reissuance, stamp, repair, downgrade or deletion; inspect read-only and use established exact-predecessor recovery only after separate authorization.',
    'audit_policies': 'Reuse approved policies A-D, existing exclusive UTF-8/LF writer with flush/fsync, exact approval/artifact/predecessor binding, one prerequisite, one single-use authorization valid for one hour and one upgrade. Require published issuance/terminal completion and confirmed cleanup, preserve historical bytes and retain sanitized progress/log/report readback. Reviewer UUID remains a local administrative reference; no new attestation or independent review record. Notification processing stays OFF.',

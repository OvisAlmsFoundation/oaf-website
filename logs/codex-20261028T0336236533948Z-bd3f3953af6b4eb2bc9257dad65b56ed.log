+"""Focused repository-only identity, publication and unchanged-control checks."""
+import ast
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import sys
+
+ROOT = Path.cwd()
+HERE = ROOT / '.pytest_cache/wu3-development-0009-v1'
+RESULT = HERE / 'evidence-validation.json'
+SOURCE = HERE / 'Invoke-Development0009Upgrade.ps1'
+platform.uname()
+
+def guard(event, args):
+    if event == 'open':
+        if isinstance(args[0], (str, bytes, os.PathLike)):
+            path = Path(os.fsdecode(args[0]))
+            assert 'MigrationAudit' not in path.parts and path.name != 'Microsoft.PowerShell_profile.ps1', 'external_audit_or_profile_access_prohibited'
+        if args[2] & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND):
+            assert isinstance(args[0], (str, bytes, os.PathLike)) and Path(args[0]) == RESULT, 'write_prohibited'
+    if (event.startswith('socket.') and event != 'socket.gethostname') or event in {'subprocess.Popen', 'os.mkdir', 'os.remove', 'os.rmdir', 'os.rename', 'os.link', 'os.symlink', 'os.truncate', 'os.chmod', 'os.utime', 'os.system'}:
+        raise RuntimeError('operational_boundary_prohibited')

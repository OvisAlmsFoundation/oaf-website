        catalog.scalar_changes["SELECT EXISTS (SELECT 1 FROM pg_catalog.pg_constraint"] = True
    with pytest.raises(c.MigrationError, match=c.Failure.DRIFT):
        v.catalog_state(catalog, catalog.i)

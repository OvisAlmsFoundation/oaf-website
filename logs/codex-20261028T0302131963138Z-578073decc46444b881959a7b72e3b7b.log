@contextmanager
def issuance_mutex():
    # Process mutex only; no new operational record or recovery framework.
    kernel = ctypes.WinDLL('kernel32', use_last_error=True)
    kernel.CreateMutexW.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_wchar_p]
    kernel.CreateMutexW.restype = ctypes.c_void_p
    kernel.WaitForSingleObject.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
    kernel.WaitForSingleObject.restype = ctypes.c_ulong
    kernel.ReleaseMutex.argtypes = [ctypes.c_void_p]
    kernel.CloseHandle.argtypes = [ctypes.c_void_p]
    name = 'Global\\OAF_Claim6_R14_' + digest(str(AUDIT).casefold().encode())
    handle = kernel.CreateMutexW(None, False, name)
    require(handle, 'issuance_mutex_unavailable')
    result = kernel.WaitForSingleObject(handle, 0)  # Never wait or retry.
    acquired = result in (0, 0x80)
    try:
        require(result == 0, 'concurrent_or_abandoned_issuance')
        yield
    finally:
        released = True
        if acquired:
            released = bool(kernel.ReleaseMutex(handle))
        closed = bool(kernel.CloseHandle(handle))
        require(released and closed, 'issuance_mutex_cleanup_unconfirmed')

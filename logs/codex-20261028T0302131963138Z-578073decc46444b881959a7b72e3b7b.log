def install_guard():
    def guard(event, args):
        if event == 'open':
            path, _, flags = args
            if flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND):
                require(isinstance(path, (str, bytes, os.PathLike)) and
                        os.fsdecode(path) in ALLOWED_WRITES and flags & os.O_EXCL and
                        flags & os.O_CREAT and not flags & (os.O_TRUNC | os.O_APPEND), 'write_prohibited')
        if event in {'os.mkdir', 'os.remove', 'os.rmdir', 'os.rename', 'os.link', 'os.symlink',
                     'os.chmod', 'os.utime', 'os.truncate', 'subprocess.Popen', 'os.system',
                     'socket.__new__', 'socket.connect', 'socket.getaddrinfo'}:
            deny()
    sys.addaudithook(guard)

def validate_records(root, binding, records, authority, prior_schema, now):
    attestation, approval = records
    require(set(attestation) == set(prior_schema), 'attestation_schema_changed')
    require(all(authority._uuid(record['id']) for record in records) and attestation['id'] != approval['id'] and
            all(not any(record['id'] in name for name in binding['audit']) for record in records), 'nonfresh_record_uuid')
    account = attestation['approval_basis']['owner_windows_account']
    require(isinstance(account, str) and account.casefold() == OWNER_ACCOUNT.casefold(), 'owner_identity_mismatch')
    require(tuple(records) == build_records(binding, attestation['id'], approval['id'], approval['approved_utc'], account),
            'record_format_or_evidence_mismatch')
    stamp = authority._utc(approval['approved_utc'])
    require(authority._utc(binding['step_a_finished_utc']) < stamp <= now and
            stamp.timestamp() >= (root / CLAIM).stat().st_mtime and
            stamp > authority._utc(authority._read(root / CLAIM)[0]['utc']), 'stale_or_future_approval_time')
    authority._approval(approval, 'prerequisite_approval', {'id': approval['id']},
                        {'environment', 'expected_start', 'approvals', 'predecessor', 'owner_reconciliation', 'testing_validation_run'}, now)
    require(set(attestation['categories']) == authority.PREREQUISITES and
            approval['approvals'] == {key: attestation['id'] for key in authority.PREREQUISITES}, 'six_category_mapping_mismatch')
    for category in attestation['categories'].values():
        require(all(ref in attestation['revision_specific_evidence'] for ref in category['evidence']), 'unbound_category_evidence')
    require(all(len(encoded(record)) <= 64000 for record in records), 'record_size_limit')

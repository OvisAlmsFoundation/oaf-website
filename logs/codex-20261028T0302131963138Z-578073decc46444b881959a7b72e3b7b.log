def safe(path, directory=False):
    require(path.is_absolute() and path.resolve() == path, 'redirected_path')
    for part in (path, *path.parents):
        require(not part.is_symlink() and not getattr(part.lstat(), 'st_file_attributes', 0) & 0x400,
                'redirected_path')
    require(path.is_dir() if directory else path.is_file(), 'missing_evidence')

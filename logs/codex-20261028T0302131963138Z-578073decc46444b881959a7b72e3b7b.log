def select_recovery(binding, path, expected_hash):
    global RECOVERY
    path = Path(path)
    require(path.is_absolute() and path.parent == HERE and path.name.startswith('owner-step-a-')
            and path.suffix == '.log', 'explicit_step_a_evidence_required')
    safe(path)
    require(len(expected_hash) == 64 and all(c in '0123456789abcdef' for c in expected_hash)
            and byte_hash(path) == expected_hash, 'step_a_exact_byte_hash_mismatch')
    lines = path.read_text(encoding='utf-8').splitlines()
    require(len(lines) == 28 and lines[0].startswith('POWERSHELL_START | STARTED | UTC ')
            and lines[24].startswith('FINISHED | INFO | UTC '), 'step_a_evidence_mismatch')
    started = lines[0].removeprefix('POWERSHELL_START | STARTED | UTC ')
    finished = lines[24].removeprefix('FINISHED | INFO | UTC ')
    expected = [lines[0], *binding['step_a_native_lines'], lines[24],
                'BOUNDARY | INFO | diagnostic evidence only; Claim 6 NOT reconciled; original authorization permanently consumed',
                'CLIPBOARD | PASS | sanitized report copied and read back exactly',
                'POWERSHELL_RESULT | PASS | owner read-only recovery verification complete']
    require(lines == expected, 'step_a_evidence_mismatch')
    RECOVERY = path.relative_to(ROOT).as_posix()
    # Copy so the immutable preparation inventory remains unchanged.
    binding = dict(binding, repository=dict(binding['repository']), step_a_lines=lines,
                   step_a_started_utc=started, step_a_finished_utc=finished)
    binding['repository'][RECOVERY] = expected_hash
    return binding

def main():
    require(len(sys.argv) == 4 and sys.argv[1] in {'inspect', 'record', 'verify'}, 'unsupported_mode')
    mode = sys.argv[1]
    require(os.name == 'nt' and Path.cwd() == ROOT and Path(__file__).absolute().parent == HERE and
            Path(sys.executable) == ROOT / '.venv/Scripts/python.exe' and sys.version_info[:2] == (3, 11), 'procedure_identity_mismatch')
    safe(HERE, directory=True)
    require(Path(os.environ.get('LOCALAPPDATA', '')) / 'OAF Website/BootstrapAudit/MigrationAudit' == AUDIT,
            'audit_destination_mismatch')
    platform.uname()  # Cache the standard library's Windows probe before subprocess guard.
    install_guard()
    binding = select_recovery(load_preparation(), sys.argv[2], sys.argv[3])
    # Reject changed code/evidence before importing any repository module.
    for name, expected in binding['repository'].items():

    $taskAudit = Join-Path $env:LOCALAPPDATA 'OAF Website\BootstrapAudit\MigrationAudit'
    if ($taskRecordHashes.Count -ne 2) { throw 'Expected exactly two saved approvals.' }
    foreach ($taskName in @($taskRecordHashes.Keys | Sort-Object)) {
        $taskPath = Join-Path $taskAudit $taskName
        $taskActual = (Get-FileHash -LiteralPath $taskPath -Algorithm SHA256).Hash.ToLowerInvariant()
        if ($taskActual -cne $taskRecordHashes[$taskName]) { throw 'Native exact-byte hash mismatch.' }
        Write-TaskLine ('NATIVE_HASH | ' + $taskName + ' | ' + $taskActual)
    }
    $script:taskRecordsVerified = $true
}

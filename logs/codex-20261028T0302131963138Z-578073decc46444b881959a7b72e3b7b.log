def prior_issuance(root, binding, authority):
    current = snapshot(root)
    extras = sorted(set(current) - set(binding['audit']))
    if not extras:
        return None
    # Report actual files even when a write was interrupted or JSON is invalid.
    for name in extras:
        require(name.isascii() and all(c.isalnum() or c in '-_.' for c in name), 'unexpected_audit_filename')
        print('EXISTING | ' + name + ' | ' + current[name], flush=True)
    require(len(extras) == 2 and sum(n.startswith('prerequisite-attestation-') for n in extras) == 1 and
            sum(n.startswith('prerequisite-approval-') for n in extras) == 1, 'prior_partial_or_intervening_issuance')
    attestation = authority._read(root / next(n for n in extras if n.startswith('prerequisite-attestation-')))[0]
    approval = authority._read(root / next(n for n in extras if n.startswith('prerequisite-approval-')))[0]
    records = (attestation, approval)
    require(set(extras) == set(names_for(records)), 'existing_record_filename_mismatch')
    return records

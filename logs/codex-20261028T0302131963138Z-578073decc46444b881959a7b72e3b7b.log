def record(root, repo, binding, authority, validation, acknowledgement, account, id_factory=uuid4, clock=lambda: datetime.now(timezone.utc)):
    # Caller holds the bounded mutex. Recheck everything after deliberate input.
    require(acknowledgement == ACK_TOKEN, 'deliberate_owner_acknowledgment_required')
    require(account.casefold() == OWNER_ACCOUNT.casefold(), 'expected_owner_windows_account_required')
    existing = prior_issuance(root, binding, authority)
    if existing:
        prior = checks(root, repo, binding, authority, validation, names_for(existing))
        saved_records(root, binding, existing, authority, prior)
        report_records(root, existing)
        return 'ALREADY_RECORDED'
    prior = checks(root, repo, binding, authority, validation)
    records = build_records(binding, str(id_factory()), str(id_factory()), clock().isoformat(), account)
    validate_records(root, binding, records, authority, prior, datetime.now(timezone.utc))
    names = names_for(records)
    ALLOWED_WRITES.update(str(root / name) for name in names)
    try:
        for index, (name, document) in enumerate(zip(names, records)):
            checks(root, repo, binding, authority, validation, names[:index])
            require(authority._previous(root, 'testing') == PREDECESSOR, 'stale_testing_predecessor')
            authority._save(root / name, document)  # Existing exclusive writer; no retry or deletion.
            require((root / name).read_bytes() == encoded(document), 'saved_bytes_mismatch')
            print('RECORD | ' + name + ' | ' + byte_hash(root / name), flush=True)
        checks(root, repo, binding, authority, validation, names)
        saved_records(root, binding, records, authority, prior)
    except BaseException:
        # A failed flush/close may have left bytes without a successful writer response.
        # Report them read-only, retaining every byte and never retrying.
        for name, value in snapshot(root).items():
            if name not in binding['audit'] and name.isascii() and all(c.isalnum() or c in '-_.' for c in name):
                print('RETAINED | ' + name + ' | ' + value, flush=True)
        raise
    finally:
        ALLOWED_WRITES.clear()
    return 'RECORDED'

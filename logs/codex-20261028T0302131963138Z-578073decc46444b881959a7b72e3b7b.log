def windows_account():
    # Actual executing Windows account, never a fabricated reviewer identity.
    size = ctypes.c_ulong(256)
    buffer = ctypes.create_unicode_buffer(size.value)
    lookup = ctypes.windll.secur32.GetUserNameExW
    lookup.argtypes = [ctypes.c_int, ctypes.c_wchar_p, ctypes.POINTER(ctypes.c_ulong)]
    lookup.restype = ctypes.c_ubyte
    require(lookup(2, buffer, ctypes.byref(size)), 'owner_identity_unavailable')
    account = buffer.value
    require(account.casefold() == OWNER_ACCOUNT.casefold(), 'expected_owner_windows_account_required')
    return account

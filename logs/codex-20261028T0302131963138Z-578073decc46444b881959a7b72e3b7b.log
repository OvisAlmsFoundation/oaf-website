def check_failure(root, authority):
    require(authority._previous(root, 'testing') == PREDECESSOR, 'stale_testing_predecessor')
    claim, claim_hash = authority._read(root / CLAIM)
    require(claim_hash == PREDECESSOR['sha256'] and claim['run_id'] == RUN and claim['authorization_id'] == AUTH,
            'failed_claim_identity_mismatch')
    historical_scope = dict(SCOPE, manifest_hash='fe94f1a7ad46e471ba0943a030bdfdd6137db04d539632fa72ceb95bbaa35589')
    require(claim['request'] == historical_scope, 'failed_claim_scope_mismatch')
    prior = {'sequence': 0, 'sha256': None}
    runs = set()
    for sequence in range(1, 7):
        old, old_hash = authority._read(root / f'claim-testing-{sequence:08d}.json')
        authorization, auth_hash = authority._authorization(root, old['authorization_id'])
        require(old['predecessor'] == prior and authorization['predecessor'] == prior and
                old['authorization_sha256'] == auth_hash and authorization['request'] == old['request'] and
                old['request']['environment'] == 'testing' and old['run_id'] not in runs,
                'contradictory_testing_claim_chain')
        require(authority._utc(authorization['issued_utc']) <= authority._utc(old['utc']) <
                authority._utc(authorization['expires_utc']) <= authority._utc(authorization['issued_utc']) + timedelta(hours=24),
                'historical_authorization_time_mismatch')
        runs.add(old['run_id'])
        prior = {'sequence': sequence, 'sha256': old_hash}
    authorization, _ = authority._authorization(root, AUTH)
    require(authorization['prerequisite_approval']['id'] == OLD_APPROVAL, 'historical_prerequisite_mismatch')
    authority._approvals(root, historical_scope, authorization['artifact_approval'], authorization['prerequisite_approval'],
                        claim['predecessor'], authority._utc(authorization['issued_utc']))
    event, history = authority._completed_run(root, root / CLAIM)
    expected = dict(historical_scope, run_id=RUN, outcome='failed', failure='drift_detected',
                    failed_phase='precommit', commit_certainty='not_invoked', database_commit_confirmed=False,
                    mutation_started=True, transaction_outcome='rollback_confirmed', lock_outcome='release_confirmed',
                    audit_write_outcome='confirmed_successful', observed_start=SCOPE['expected_start'],
                    verified_identity=True, secondary_failures=[], interruption_phase=None,
                    validation_outcome='failed')
    require(all(event.get(key) == value for key, value in expected.items()), 'failure_or_cleanup_mismatch')
    require(all(event['cleanup'][key] == 'confirmed_successful' for key in
                ('rollback', 'advisory_unlock', 'connection_close', 'engine_dispose')) and
            [item['phase'] for item in history] == ['authorization', 'lock', 'preflight', 'revision'] and
            authority._continuation_state(event, history) is None, 'exceptional_recovery_evidence_mismatch')
    terminal = root / f'terminal-{RUN}.json'
    require(terminal.with_name('completed-' + terminal.name).samefile(terminal.with_name('pending-' + terminal.name)),
            'terminal_publication_mismatch')
    require((root / f'completed-authorization-{AUTH}.json').samefile(root / f'pending-authorization-{AUTH}.json'),
            'authorization_publication_mismatch')
    require(authority._previous(root, 'testing') == PREDECESSOR, 'stale_testing_predecessor')
    return event

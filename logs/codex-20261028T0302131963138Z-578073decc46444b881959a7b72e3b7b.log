def evidence_map(binding):
    names = [CLAIM, f'authorization-{AUTH}.json', f'completed-authorization-{AUTH}.json',
             f'terminal-{RUN}.json', f'completed-terminal-{RUN}.json',
             f'artifact-approval-{ARTIFACT_ID}.json', f'prerequisite-approval-{OLD_APPROVAL}.json',
             f'prerequisite-attestation-{PRIOR_ATTESTATION}.json']
    names += [f'event-{RUN}-{n:08d}.json' for n in range(1, 5)]
    names += [f'pending-authorization-{AUTH}.json', f'pending-terminal-{RUN}.json']
    evidence = {'MigrationAudit/' + name: {'location': 'MigrationAudit', 'hash_mode': 'sha256-exact-bytes',
                                         'sha256': binding['audit'][name]} for name in names}
    for name, value in binding['repository'].items():
        evidence[name] = {'location': 'repository', 'hash_mode': 'sha256-exact-bytes', 'sha256': value}
    evidence['owner_recording_instruction'] = {'location': 'embedded_owner_instruction', 'hash_mode': 'sha256-utf8-lf',
        'content': ACK, 'sha256': digest(ACK.encode()),
        'source': 'Displayed and deliberately adopted during owner execution; local administrative acknowledgment, not a signature.'}
    reported = 'Owner task reports R10 reproduced PostgreSQL-generated TOAST dependency rejection; R11 repaired migration_validation.py; R12 ASTRA independent repair review PASS for current repaired artifacts. No reviewer identity/signature or independent report is fabricated; no certification is repeated here.'
    evidence['owner_reported_r10_r12'] = {'location': 'embedded_owner_instruction',
        'content': reported, 'hash_mode': 'sha256-utf8-lf', 'sha256': digest(reported.encode()),
        'source': 'Checkpoint 6G-2H-R14 owner task, completed recovery evidence.'}
    return evidence

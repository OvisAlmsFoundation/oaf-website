function Confirm-TaskOwner {
    $taskAccount = [Security.Principal.WindowsIdentity]::GetCurrent().Name
    if ($taskAccount -ine 'OAF-DELL5511\ovisa') { throw 'Expected owner Windows account.' }
    $taskAudit = Join-Path $env:LOCALAPPDATA 'OAF Website\BootstrapAudit\MigrationAudit'
    if ((Get-Acl -LiteralPath $taskAudit).Owner -ine $taskAccount) { throw 'Audit owner mismatch.' }
    Write-TaskLine ('OWNER | ' + $taskAccount)
    Write-TaskLine ('PROMPT | Type exactly: ' + $taskToken)
    $taskAcknowledgment = Read-Host 'Owner acknowledgment'
    if ($taskAcknowledgment -cne $taskToken) { throw 'Owner acknowledgment declined.' }
    Write-TaskLine 'ACKNOWLEDGMENT | accepted for exact displayed Claim 6 and six categories'
    return $taskAcknowledgment
}

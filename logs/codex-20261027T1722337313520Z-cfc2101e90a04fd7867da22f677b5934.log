174:     def _budget(self, connection, bucket, now, maximum, cooldown):
175:         record = self._get(connection, limits, bucket=bucket)
176:         start, count = (record["window_start"], record["requests"]) if record else (now, 0)
177:         if now >= start + timedelta(days=1):
178:             start, count = now, 0
179:         if record and (now < record["last_requested_at"] + timedelta(seconds=cooldown) or count >= maximum):
180:             return False
181:         values = dict(window_start=start, last_requested_at=now, requests=count + 1)
182:         if record:
183:             self._update(connection, limits, dict(bucket=bucket), **values)
184:         else:
185:             self._insert(connection, limits, dict(bucket=bucket, **values))
186:         return True
187: 
188:     def request_confirmation(self, email):
189:         """Internal sensitive return only. Public callers discard it for a generic receipt.
190: 
191:         Unknown, verified, suppressed and throttled addresses all return None.
192:         All requests consume the global budget; mailbox limits survive resubscription.
193:         """
194:         email = normalize_email(email)
195:         with self._transaction() as (connection, now):
196:             return self._request_confirmation(connection, now, email)
197: 
198:     def _request_confirmation(self, connection, now, email):
199:         """Share the caller's locked transaction, including a newly inserted signup."""
200:         if not self._budget(connection, self._digest("budget", "global"), now, 1000, 0):
201:             retain_failure("confirmation_reservation", "confirmation_global_budget")
202:             return None
203:         mailbox = self._digest("mailbox", email)
204:         if not self._budget(connection, mailbox, now, 5, 60):
205:             retain_failure("confirmation_reservation", "confirmation_mailbox_budget")
206:             return None
207:         subscriber = self._get(connection, notifications, email=email, unsubscribed_at=None)
208:         if subscriber is None:
209:             retain_failure("confirmation_reservation", "confirmation_active_subscriber")
210:             return None
211:         if self._get(connection, suppressions, mailbox_digest=mailbox):
212:             retain_failure("confirmation_reservation", "confirmation_not_suppressed")
213:             return None
214:         key = dict(subscription=subscriber["unsubscribe_digest"])
215:         record = self._get(connection, verification, **key)
216:         if record and record["verified_at"] is not None:
217:             return None
218:         from .confirmation_outbox import reserve_confirmation
219:         return reserve_confirmation(self, connection, now, subscriber, record)
220: 
221:     def confirm(self, token):
222:         """Verified/already_verified/unavailable; valid replay only until original expiry."""
223:         if type(token) is not str or not HEX.fullmatch(token):
224:             retain_failure("confirmation_authority", "confirmation_token_format")
225:             return "unavailable"
226:         with self._transaction() as (connection, now):
227:             record = self._get(connection, verification, token_digest=self._digest("confirmation", token))
228:             if record is None:
229:                 retain_failure("confirmation_authority", "confirmation_token_present")
230:                 return "unavailable"
231:             subscriber = self._get(connection, notifications, unsubscribe_digest=record["subscription"])
232:             if subscriber["unsubscribed_at"] is not None:
233:                 retain_failure("confirmation_authority", "confirmation_lifecycle_active")
234:                 return "unavailable"
235:             if now >= record["expires_at"]:
236:                 retain_failure("confirmation_authority", "confirmation_not_expired")
237:                 return "unavailable"
238:             if now < record["issued_at"]:
239:                 retain_failure("confirmation_authority", "confirmation_not_future")
240:                 return "unavailable"
241:             if self._get(connection, suppressions, mailbox_digest=self._digest("mailbox", subscriber["email"])):
242:                 retain_failure("confirmation_authority", "confirmation_not_suppressed")
243:                 return "unavailable"
244:             # Classify only after the same capability, expiry and lifecycle checks.
245:             if record["verified_at"] is not None:
246:                 return "already_verified"
247:             self._update(connection, verification, dict(subscription=record["subscription"]), verified_at=now)
248:             return "verified"

"'$taskDocs = @('"'docs/WORKFLOW.md', 'docs/WEBSITE_PLAN.md')
"'$taskSha = [System.Security.Cryptography.SHA256]::Create()
$taskPreserved = 0
$taskPrefixCount = 0
try {
foreach ($taskRecord in $taskBaseline.tracked) {
    if ($taskDocs -contains $taskRecord.path) {
        $taskBytes = [System.IO.File]::ReadAllBytes((Join-Path $PWD.Path $taskRecord.path))
        if ($taskBytes.Length -le $taskRecord.length) { throw ('"'Missing documentation append: ' + "'$taskRecord.path) }
        $taskPrefixHash = [System.BitConverter]::ToString($taskSha.ComputeHash($taskBytes, 0, [int]$taskRecord.length)).Replace('"'-', '').ToLowerInvariant()
        if ("'$taskPrefixHash -cne $taskRecord.sha256) { throw ('"'Historical document prefix changed: ' + "'$taskRecord.path) }
        $taskStrictUtf8 = New-Object System.Text.UTF8Encoding($false, $true)
        $taskAppend = $taskStrictUtf8.GetString($taskBytes, [int]$taskRecord.length, ($taskBytes.Length - [int]$taskRecord.length))
        foreach ($taskRequired in @('"'READY FOR OWNER CLOSURE; NOT CLOSED', 'NOT YET OWNER-APPROVED', '55dbeb46', 'agweb01', 'Git-thread handoff', 'APPLIED_AND_VERIFIED', 'ONE smallest next checkpoint')) {
            if (-not "'$taskAppend.Contains($taskRequired)) { throw ('"'Current documentation consistency gap: ' + "'$taskRecord.path + '"' / ' + "'$taskRequired) }
        }
        $taskPrefixCount++
    } else {
        if ((Get-FileHash -LiteralPath $taskRecord.path -Algorithm SHA256).Hash -ine $taskRecord.sha256) { throw ('"'Non-document tracked content changed: ' + "'$taskRecord.path) }
        $taskPreserved++
    }
}

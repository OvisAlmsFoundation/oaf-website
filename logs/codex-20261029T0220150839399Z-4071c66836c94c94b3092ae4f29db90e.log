jobs:
  tests:
    name: Pytest shard ${{ matrix.shard }}
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    strategy:
      fail-fast: false
      max-parallel: 2
      matrix:
        shard: [0, 1]
    env:
      PYTEST_DISABLE_PLUGIN_AUTOLOAD: "1"
      PYTEST_ADDOPTS: ""
      PYTEST_PLUGINS: ""
      PYTHONPATH: ${{ github.workspace }}:${{ github.workspace }}/tests
      OAF_ENV: testing
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Install canonical dependencies in website environment
        run: |
          python -m venv .venv
          .venv/bin/python -m pip install -r requirements-dev.txt -r requirements-migrations.txt
      - name: Run disjoint canonical shard with branch coverage
        run: .venv/bin/python -B ops/ci_pytest.py shard --shard ${{ matrix.shard }}
      - name: Upload only synthetic test inventory and coverage arcs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: linux-shard-${{ matrix.shard }}
          path: |
            .pytest_cache/ci/run/shard-${{ matrix.shard }}/manifest.json
            .pytest_cache/ci/run/shard-${{ matrix.shard }}/arcs.json
          include-hidden-files: true
          if-no-files-found: error
          retention-days: 7
System.Management.Automation.RemoteException
  coverage:
    name: Combined statement and branch coverage
    needs: tests
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: python -m pip install -r requirements-dev.txt
      - uses: actions/download-artifact@v4
        with:
          pattern: linux-shard-*
          path: .pytest_cache/ci/downloads
      - name: Verify complete disjoint suite and enforce exact 100% coverage
        run: python -B ops/ci_pytest.py combine

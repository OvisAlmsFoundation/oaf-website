+    if case == "missing": catalog.dependencies.remove(edge)
+    if case == "additional": catalog.dependencies.append(deepcopy(edge))
+    if case == "wrong_type": edge["deptype"] = "n"
+    if case == "source_subobject": edge["objsubid"] = 1

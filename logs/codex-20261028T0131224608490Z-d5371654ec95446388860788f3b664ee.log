def choose_port():
    for _ in range(40):
        port = 55000 + secrets.randbelow(5000)
        try:
            with socket.socket() as probe:
                if os.name == "nt":
                    probe.setsockopt(socket.SOL_SOCKET, socket.SO_EXCLUSIVEADDRUSE, 1)
                probe.bind(("127.0.0.1", port))
            return port
        except OSError:
            continue
    raise GuardError("no_verified_unused_disposable_port")

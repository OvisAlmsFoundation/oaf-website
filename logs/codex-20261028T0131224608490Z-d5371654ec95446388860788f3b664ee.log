def native_output_file():
    # On Windows O_TEMPORARY deletes on the LAST handle close, including inherited
    # handles. Closing our files never waits for a descendant or for pipe EOF.
    need(os.name == "nt", "windows_required")
    path = checked_child(BASE / ("native-" + uuid.uuid4().hex + ".tmp"))
    try:
        return open(path, "x+b", opener=lambda name, flags: os.open(name, flags | os.O_TEMPORARY, 0o600))
    except OSError as error:
        raise GuardError("native_output_unavailable") from error

    def stop_and_remove(self):
        """Never kill by image/name. Never remove files without confirmed shutdown."""
        if not self.owned:
            return {"status": "not_created"}
        checked_child(self.run)
        if self.start_requested:
            if (self.data / "postmaster.pid").exists():
                self.capture_process()
                native(BIN / "pg_ctl.exe", ["-D", self.data, "-w", "-t", "30", "-m", "fast", "stop"], timeout=40)
            if self.process is not None:
                need(self.process.stopped(), "postmaster_shutdown_unconfirmed")
            else:
                # A startup failure with no captured handle must still prove pg_ctl sees no server.
                need(native(BIN / "pg_ctl.exe", ["-D", self.data, "status"], allowed=(3,)).returncode == 3,
                     "failed_start_shutdown_unconfirmed")
            need(not (self.data / "postmaster.pid").exists(), "postmaster_pidfile_survived_shutdown")
            with socket.socket() as probe:
                if os.name == "nt":
                    probe.setsockopt(socket.SOL_SOCKET, socket.SO_EXCLUSIVEADDRUSE, 1)
                probe.bind(("127.0.0.1", self.port))
        if self.process is not None:
            self.process.close()
        # Check the entire tree immediately before the one bounded recursive removal.
        for directory, subdirectories, files in os.walk(self.run, followlinks=False):
            checked_child(directory) if Path(directory) != self.run else no_redirect(directory)
            for name in subdirectories + files:
                checked_child(Path(directory) / name, self.run)
        shutil.rmtree(self.run)
        need(not self.run.exists(), "disposable_files_removal_unconfirmed")
        self.admin_password = self.migrator_password = None
        return {"status": "stopped_and_removed", "postmaster_stopped": True,
                "data_directory_removed": True, "only_created_run_directory_removed": True}

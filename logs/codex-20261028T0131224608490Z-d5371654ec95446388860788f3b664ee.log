def exception_fields(error):
    """No exception messages, SQL text, SQL parameters or traceback locals."""
    result = {"classes": [], "sqlstate": None}
    pending, seen = [error], set()
    while pending:
        item = pending.pop(0)
        if not isinstance(item, BaseException) or id(item) in seen:
            continue
        seen.add(id(item))
        name = type(item).__module__ + "." + type(item).__name__
        result["classes"].append(name if re.fullmatch(r"[A-Za-z_][A-Za-z_0-9.]*", name) else "Exception")
        code = getattr(item, "sqlstate", None)
        if result["sqlstate"] is None and isinstance(code, str) and re.fullmatch(r"[0-9A-Z]{5}", code):
            result["sqlstate"] = code
        pending.extend(getattr(item, key, None) for key in ("orig", "__cause__", "__context__"))
    if isinstance(error, GuardError) and error.args and re.fullmatch(r"[a-z0-9_]+", error.args[0]):
        result["guard"] = error.args[0]
    for key in ("winerror", "errno"):
        value = getattr(error, key, None)
        if type(value) is int:
            result[key] = value
    locations, tb = [], error.__traceback__
    while tb:
        path = Path(tb.tb_frame.f_code.co_filename)
        if path.is_relative_to(ROOT):
            locations.append({"file": path.relative_to(ROOT).as_posix(),
                              "function": tb.tb_frame.f_code.co_name, "line": tb.tb_lineno})
        tb = tb.tb_next
    result["source_locations"] = locations
    return result

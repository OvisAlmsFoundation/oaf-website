def native_audit_arguments(executable, arguments):
    """Decode the real Windows audit command line before applying argument guards.
System.Management.Automation.RemoteException
    CPython on Windows emits a string command line, not the list passed to
    Popen. The explicit executable in native() also prevents its audit value
    from being None. Reject unbound/noncanonical invocations without launching.
    """
    need(isinstance(executable, str) and bool(executable), "native_executable_not_explicit")
    if isinstance(arguments, str):
        need(os.name == "nt" and bool(arguments) and "\0" not in arguments, "invalid_native_command_line")
        from ctypes import wintypes
        shell = ctypes.WinDLL("shell32", use_last_error=True)
        kernel = ctypes.WinDLL("kernel32", use_last_error=True)
        shell.CommandLineToArgvW.argtypes = [wintypes.LPCWSTR, ctypes.POINTER(ctypes.c_int)]
        shell.CommandLineToArgvW.restype = ctypes.POINTER(wintypes.LPWSTR)
        kernel.LocalFree.argtypes = [wintypes.HLOCAL]
        kernel.LocalFree.restype = wintypes.HLOCAL
        count = ctypes.c_int()
        pointer = shell.CommandLineToArgvW(arguments, ctypes.byref(count))
        need(bool(pointer), "native_command_line_decode_failed")
        try:
            parsed = [pointer[index] for index in range(count.value)]
        finally:
            freed = kernel.LocalFree(ctypes.cast(pointer, wintypes.HLOCAL))
            need(freed is None, "native_command_line_free_failed")
        need(subprocess.list2cmdline(parsed) == arguments, "noncanonical_native_command_line")
    else:
        need(isinstance(arguments, (list, tuple)), "invalid_native_arguments")
        parsed = list(arguments)
    need(bool(parsed) and all(isinstance(value, str) for value in parsed)
         and parsed[0] == executable, "native_executable_argument_mismatch")
    return parsed

def native(executable, arguments, *, timeout=60, allowed=(0,)):
    need(type(timeout) in (int, float) and 0 < timeout < float("inf"), "invalid_native_timeout")
    environment = child_environment()
    if executable == "git":
        # Preserve the terminal's existing Git configuration/ownership context.
        # This command is local/read-only; no value from its environment is logged.
        environment = dict(os.environ, GIT_OPTIONAL_LOCKS="0")
    program = str(git_program()) if executable == "git" else str(executable)
    argv = [program, *map(str, arguments)]
    # DEVNULL is opened read/write internally by Popen. A read-only null handle
    # supplies the same EOF without an exception to the existing write guard.
    with open(os.devnull, "rb") as stdin, native_output_file() as stdout, native_output_file() as stderr:
        process = subprocess.Popen(argv, executable=program, cwd=ROOT, env=environment,
                                   stdin=stdin, stdout=stdout, stderr=stderr,
                                   close_fds=True, shell=False)
        # Do not use Popen's context manager: its __exit__ can wait indefinitely.
        try:
            returncode = process.wait(timeout=timeout)
        except BaseException as error:
            reap_native_child(process)
            if isinstance(error, subprocess.TimeoutExpired):
                raise GuardError("native_command_timeout") from error
            raise
        result = subprocess.CompletedProcess(argv, returncode, native_output(stdout), native_output(stderr))
    if result.returncode not in allowed:
        # Decode only to select a fixed nonsecret cause. Never render native text.
        detail = (result.stderr + result.stdout).decode("utf-8", errors="replace").lower()
        category = "command_failed"
        for phrase, label in (("permission denied", "permission_denied"), ("access is denied", "access_denied"),
                              ("no space left", "disk_space_unavailable"), ("could not bind", "port_bind_failed"),
                              ("invalid locale", "locale_unavailable"), ("could not create directory", "directory_creation_failed"),
                              ("could not load library", "installed_runtime_library_unavailable")):
            if phrase in detail:
                category = label
                break
        raise GuardError(Path(executable).stem + "_exit_" + str(abs(result.returncode)) + "_" + category)
    return result

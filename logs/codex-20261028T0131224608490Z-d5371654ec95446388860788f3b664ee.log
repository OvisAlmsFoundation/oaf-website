function Test-TaskSafeValue($Value, [int]$Depth = 0) {
    if ($Depth -gt 24) { return $false }
    if ($null -eq $Value -or $Value -is [bool] -or $Value -is [ValueType]) { return $true }
    if ($Value -is [string]) {
        return ($Value.Length -le 524288 -and $Value -notmatch '[\x00-\x08\x0b\x0c\x0e-\x1f]' -and
            $Value -notmatch '(?i)(postgres(?:ql)?(?:\+psycopg)?://|password\s*=|PGPASSWORD\s*=|SYNTHETIC_PRIVATE_VALUE)')
    }
    if ($Value -is [System.Collections.IEnumerable] -and $Value -isnot [pscustomobject]) {
        foreach ($taskItem in $Value) { if (-not (Test-TaskSafeValue $taskItem ($Depth + 1))) { return $false } }
        return $true
    }
    if ($Value -is [pscustomobject]) {
        foreach ($taskProperty in $Value.PSObject.Properties) {
            if ($taskProperty.Name -match '(?i)(password|credential_service|connection_string|sql_parameters|raw_error|environment_dump|^dsn$)') { return $false }
            if (-not (Test-TaskSafeValue $taskProperty.Value ($Depth + 1))) { return $false }
        }
        return $true
    }
    return $false
}

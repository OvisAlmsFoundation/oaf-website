    def failure(self, error):
        frames, tb = [], error.__traceback__
        while tb:
            if tb.tb_frame.f_code.co_filename in self.files:
                frames.append((tb.tb_frame, tb.tb_lineno))
            tb = tb.tb_next
        candidates = [(f, line) for f, line in frames if f.f_code.co_name not in {"rows", "scalar", "require"}]
        frame, line = (candidates or frames)[-1] if frames else (None, None)
        sites = [] if frame is None else [s for s in self.operations if
            s["file"] == self.files[frame.f_code.co_filename] and s["function"] == frame.f_code.co_name and
            (s["line"] <= line <= s["end_line"] or line in s["failure_lines"])]
        site = min(sites, key=lambda s: s["end_line"] - s["line"]) if sites else None
        metadata = {} if frame is None else {k: catalog_value(v) for k, v in frame.f_locals.items() if k in CATALOG_LOCALS}
        source_expected = {}
        if frame is not None and "identity" in frame.f_locals:
            source_expected["schema_owner"] = frame.f_locals["identity"].owner
        # Render pure source contracts for a table comparison without running any
        # validator/query after the failure. The predicate/source and locals cover
        # other comparisons, including the dependency endpoint requirement.
        for candidate, _ in frames:
            item = candidate.f_locals.get("item")
            if item is not None and hasattr(item, "columns") and candidate.f_code.co_name == "verify_delivery":
                from oaf_website.notification_delivery_validation import column_contract, index_contract
                source_expected.update(object="oaf_website." + item.name,
                                       columns=column_contract(item), indexes=index_contract(item))
        stack_metadata = [{"function": f.f_code.co_name, "file": self.files[f.f_code.co_filename],
                           "line": ln, "catalog_metadata": {k: catalog_value(v) for k, v in f.f_locals.items() if k in CATALOG_LOCALS}}
                          for f, ln in frames if f.f_code.co_name not in {"rows", "scalar", "require"}]
        return {"operation": site, "source": None if frame is None else {
            "file": self.files[frame.f_code.co_filename], "function": frame.f_code.co_name, "line": line},
            "expected_and_actual_catalog_locals": metadata, "exception": exception_fields(error),
            "expected_from_current_source": source_expected,
            "validation_stack_catalog_metadata": stack_metadata,
            "raised_as_drift_detected": getattr(error, "classification", None) == "drift_detected",

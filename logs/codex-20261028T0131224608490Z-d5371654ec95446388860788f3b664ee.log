def native_output(stream):
    # Use an independent file offset: seeking the inherited write handle could
    # disturb a still-running descendant. Read one finite snapshot, never EOF.
    path = checked_child(stream.name)
    flags = os.O_RDONLY | getattr(os, "O_BINARY", 0) | getattr(os, "O_TEMPORARY", 0)
    try:
        with os.fdopen(os.open(path, flags), "rb") as captured:
            size = os.fstat(captured.fileno()).st_size
            need(size <= 8 * 1024 * 1024, "native_output_limit_exceeded")
            value = captured.read(size)
            need(len(value) == size, "native_output_incomplete")
            return value
    except OSError as error:
        raise GuardError("native_output_unavailable") from error

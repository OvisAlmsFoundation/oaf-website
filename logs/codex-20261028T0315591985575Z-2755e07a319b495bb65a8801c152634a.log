+code = compile(ast.Module(body=[loop], type_ignores=[]), 'actual_duplicate_gate', 'exec')
+results = []
+for scenario, expected in (
+        ('exact_published_reconciliation_allowed', None),
+        ('second_matching_prerequisite', 'unexpected_matching_prerequisite_inspect_readonly_no_retry'),
+        ('existing_successor_authorization', 'claim13_authorization_already_exists_inspect_readonly_no_reissue'),
+        ('partial_record', 'JSONDecodeError')):
+    saved_argv = sys.argv

+prefix = prefix.replace("LOG = FOLDER / ('owner-boundary-validation-attempt3.log' if CONTINUE else 'owner-boundary-validation.log')", "LOG = FOLDER / 'duplicate-validation.log'")
+prefix = prefix.replace("RESULT = FOLDER / 'owner-boundary-validation.json'", "RESULT = FOLDER / 'duplicate-validation.json'")
+exec(compile(prefix, 'accepted_virtual_fixture_definitions', 'exec'), globals())

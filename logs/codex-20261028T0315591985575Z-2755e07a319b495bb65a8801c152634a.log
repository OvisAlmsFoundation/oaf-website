+            path = Path(os.fsdecode(args[0]))
+            assert 'MigrationAudit' not in path.parts and path.name != 'Microsoft.PowerShell_profile.ps1', 'external_audit_or_profile_access_prohibited'
+        if args[2] & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND):
+            assert isinstance(args[0], (str, bytes, os.PathLike)) and Path(args[0]) == RESULT, 'write_prohibited'
+    if (event.startswith('socket.') and event != 'socket.gethostname') or event in {'subprocess.Popen', 'os.mkdir', 'os.remove', 'os.rmdir', 'os.rename', 'os.link', 'os.symlink', 'os.truncate', 'os.chmod', 'os.utime', 'os.system'}:
+        raise RuntimeError('operation_prohibited')
+
+sys.addaudithook(guard)
+sys.path.insert(0, str(ROOT))
+sha = lambda b: hashlib.sha256(b).hexdigest()
+package = json.loads((HERE / 'package.json').read_bytes())
+assert sha(SOURCE.read_bytes()) == package['source_sha256']
+verified, deferred = [], []
+for name, digest in package['dependencies'].items():
+    path = Path(name)
+    if path.is_relative_to(ROOT):
+        assert sha(path.read_bytes()) == digest, name
+        verified.append(name)
+    else:
+        deferred.append(dict(path=name, sha256=digest))
+source = SOURCE.read_text()
+code = source.split("    $taskCode = @'\n", 1)[1].split("\n'@", 1)[0]
+compile(code, 'embedded_python', 'exec')
+tree = ast.parse(code)
+oldsource = Path(package['reused_source']).read_text()
+oldcode = oldsource.split("    $taskCode = @'\n", 1)[1].split("\n'@", 1)[0]
+functions = lambda value: {n.name: ast.dump(n) for n in ast.parse(value).body if isinstance(n, ast.FunctionDef) and n.name != 'main'}
+assert functions(code) == functions(oldcode), 'helper_control_flow_changed'
+
+def normalize_outer(value, embedded):

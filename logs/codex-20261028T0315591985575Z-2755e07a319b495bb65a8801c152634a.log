def child_json(argv, kind):
    # Both existing CLIs emit one bounded sanitized JSON object; never print raw stderr.
    child = subprocess.Popen(argv, cwd=ROOT, env=dict(os.environ), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    out, err = child.communicate()
    emit('NATIVE_EXIT | ' + kind + ' | ' + str(child.returncode))
    require(len(out) <= 64000 and len(err) <= 64000, kind + '_output_size_invalid')
    require(not err, kind + '_unexpected_stderr_suppressed')
    try: result = json.loads(out, object_pairs_hook=a._unique)
    except (ValueError, UnicodeError): raise Stop(kind + '_json_unavailable')
    require(type(result) is dict, kind + '_json_not_object')
    if kind == 'issuer':
        require(set(result) in ({'outcome', 'authorization_id'}, {'outcome', 'classification'}), 'issuer_result_fields_invalid')
        require(result.get('outcome') in {'issued', 'denied'}, 'issuer_outcome_invalid')
        require(result.get('authorization_id') is None or a._uuid(result['authorization_id']), 'issuer_uuid_invalid')
        require(result.get('classification') is None or result['classification'] == mc.Failure.OPERATIONAL_GATE, 'issuer_classification_invalid')
    else:
        # Validate against the runner's existing result contract, even on nonzero exit.
        allowed = set(m._Evidence(m.Request(**SCOPE), mc.IDENTITIES['testing'], str(uuid4())).result('pending', None))
        require(set(result) <= allowed | {'secondary_failure'}, 'runner_result_fields_invalid')
        require(result.get('outcome') in {'applied_and_verified', 'failed'}, 'runner_outcome_invalid')
        require(result.get('run_id') is None or a._uuid(result['run_id']), 'runner_run_id_invalid')
        for key in ('classification', 'failed_phase', 'commit_certainty', 'interruption_phase', 'lock_outcome', 'validation_outcome', 'audit_write_outcome', 'transaction_outcome', 'secondary_failure'):
            require(result.get(key) is None or result[key] in a._VALUES, 'runner_scalar_invalid')
        for key in ('mutation_started', 'database_commit_confirmed'):
            require(key not in result or type(result[key]) is bool, 'runner_boolean_invalid')
        for key in ('cleanup', 'cleanup_attempts'):
            if key in result:
                require(type(result[key]) is dict and set(result[key]) == a._COMPONENTS, 'runner_cleanup_fields_invalid')
                for value in result[key].values():
                    require((key == 'cleanup' and value in a._ATTEMPTS | {'not_attempted'}) or (key == 'cleanup_attempts' and type(value) is list and all(x in a._ATTEMPTS for x in value)), 'runner_cleanup_value_invalid')
        require(type(result.get('secondary_failures', [])) is list, 'runner_secondary_invalid')
        for failure in result.get('secondary_failures', []):
            require(type(failure) is dict and set(failure) == {'component', 'classification'} and failure['component'] in a._COMPONENTS | {'commit'} and failure['classification'] in a._VALUES, 'runner_secondary_value_invalid')
    emit('CHILD_RESULT | ' + kind + ' | ' + json.dumps(result, sort_keys=True))

+</head>
+<body class="legal-page">
+
+  <a class="button legal-skip-link" href="#main-content">Skip to main content</a>
+
+{navigation}
+
+  <main id="main-content" tabindex="-1">
+    <article aria-labelledby="legal-title">
+      <header class="content-section legal-intro">
+        <div class="section-inner">
+          <h1 id="legal-title">{title}</h1>
+
+{metadata}
+        </div>
+      </header>
+
+      <div class="content-section legal-content">
+        <div class="section-inner">
+{chr(10).join(sections)}
+        </div>
+      </div>
+    </article>
+  </main>
+
+{footer.replace(f'href="{slug}.html"', f'href="{slug}.html" aria-current="page"')}
+
+</body>
+</html>
+'''
+    with (ROOT / f'{slug}.html').open('x', encoding='utf-8', newline='\n') as stream:
+        stream.write(content)
+print('PASS both semantic HTML documents generated directly from verified sources', flush=True)
+
+print('STARTED legal_footer_links', flush=True)
+for name in PAGES:
+    path = ROOT / name
+    data = path.read_bytes()
+    if name in ('confirm-email.html', 'manage-notifications.html'):
+        newline = b'\r\n' if b'\r\n' in data else b'\n'
+        match = re.search(rb'  <footer>.*?</footer>', data, re.S)
+        assert match and b'footer-links' not in match[0]
+        data = data[:match.start()] + footer.encode().replace(b'\n', newline) + data[match.end():]
+    else:

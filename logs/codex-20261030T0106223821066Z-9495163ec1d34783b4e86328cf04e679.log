+                    page.reload(wait_until='networkidle')
+                    visited = []
+                    for index in range(9):
+                        page.keyboard.press('Tab')
+                        node = page.locator(':focus')
+                        href = node.get_attribute('href')
+                        visited.append(href)
+                        info = node.evaluate('''e => {
+                          const r=e.getBoundingClientRect(), s=getComputedStyle(e), header=document.querySelector('.site-header').getBoundingClientRect();
+                          return {visible:e.matches(':focus-visible'),outline:s.outlineStyle,width:parseFloat(s.outlineWidth),
+                            left:r.left,right:r.right,top:r.top,bottom:r.bottom,headerBottom:header.bottom,
+                            footer:!!e.closest('footer')};
+                        }''')
+                        assert info['visible'] and info['outline'] != 'none' and info['width'] >= 2
+                        assert info['left'] >= 0 and info['right'] <= width and info['top'] >= 0 and info['bottom'] <= 844

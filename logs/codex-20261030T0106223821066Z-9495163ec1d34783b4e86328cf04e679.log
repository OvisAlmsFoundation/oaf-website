+    title = preamble.pop(0).removeprefix('# ')
+    sections = []
+    for index in range(0, len(parts), 2):
+        number = index // 2 + 1
+        assert parts[index].startswith(f'{number}. ')
+        sections.append(f'''        <section aria-labelledby="section-{number}">
+          <h2 id="section-{number}">{html.escape(parts[index], quote=False)}</h2>
+
+{blocks(parts[index + 1])}
+        </section>''')
+    metadata = blocks('\n\n'.join(preamble))
+    content = f'''<!DOCTYPE html>
+<html lang="en">

+def started(name):
+    global stage
+    stage = name
+    print(f'STARTED {stage}', flush=True)
+
+def normalized(text):
+    return ' '.join(text.split())
+
+class Document(HTMLParser):
+    def __init__(self, text):
+        super().__init__(convert_charrefs=True)
+        self.article = False
+        self.current = None
+        self.strong = None
+        self.blocks = []
+        self.emphasis = []
+        self.ids = []
+        self.labels = []
+        self.links = []
+        self.sections = []
+        self.feed(text)
+
+    def handle_starttag(self, tag, pairs):
+        attrs = dict(pairs)
+        if 'id' in attrs:
+            self.ids.append(attrs['id'])
+        if 'aria-labelledby' in attrs:
+            self.labels.extend(attrs['aria-labelledby'].split())
+        if tag == 'a':
+            self.links.append(attrs.get('href'))
+        if tag == 'article':
+            self.article = True
+        if self.article and tag == 'section':
+            self.sections.append(attrs.get('aria-labelledby'))
+        if self.article and tag in ('h1', 'h2', 'h3', 'p', 'li'):
+            assert self.current is None, 'Invalid nested content block'
+            self.current = [tag, '']
+        if self.article and tag == 'strong':
+            self.strong = ''
+        if self.current and tag == 'br':
+            self.current[1] += ' '
+
+    def handle_data(self, value):
+        if self.current is not None:
+            self.current[1] += value
+        if self.strong is not None:
+            self.strong += value
+
+    def handle_endtag(self, tag):
+        if self.article and tag in ('h1', 'h2', 'h3', 'p', 'li'):
+            assert self.current and self.current[0] == tag
+            self.blocks.append((tag, normalized(self.current[1])))
+            self.current = None
+        if self.article and tag == 'strong':
+            self.emphasis.append(self.strong)
+            self.strong = None
+        if tag == 'article':
+            self.article = False
+
+def expected_blocks(markdown):
+    expected = []
+    for block in re.split(r'\n\s*\n', markdown.strip()):
+        heading = re.match(r'^(#{1,3}) (.*)$', block)
+        if heading:
+            expected.append((f'h{len(heading[1])}', normalized(heading[2])))
+        elif block.startswith('- '):
+            expected.extend(('li', normalized(line[2:].replace('**', ''))) for line in block.splitlines())
+        else:

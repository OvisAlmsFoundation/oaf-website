+"""Focused static-page checks with the existing Playwright/Chromium installation."""
+from collections import Counter
+from functools import partial
+from html.parser import HTMLParser
+from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+from threading import Thread
+from urllib.parse import unquote, urlsplit
+import ast
+import hashlib
+import json
+import re
+import subprocess
+import sys
+import traceback
+
+from playwright.sync_api import sync_playwright
+
+ROOT = Path.cwd()
+RUN = Path(__file__).resolve().parent
+DRAFTS = ROOT / '.pytest_cache/approved-legal-pages-3f65c208cc174d95bddeae349d753412'
+HASHES = {
+    'privacy-policy': '0D3AC043A27E42E868F6E3E914409D6B0947C96BE84BFDEA9AE1971D6FE8CAB8',
+    'terms-of-use': '5BB4BFBF36148951ED24B37DF5116D4FE7218B8A19D5EAC35DDACFD8197AC798',
+}
+OLD = ['index.html', 'about.html', 'gramanna.html', 'faq.html', 'contact.html', 'support.html',
+       'confirm-email.html', 'manage-notifications.html']
+PAGES = OLD + [f'{slug}.html' for slug in HASHES]
+stage = 'initialization'
+results = []
+
+def passed(name, **facts):
+    results.append({'check': name, 'status': 'PASS', **facts})
+    print(f'PASS {name} {json.dumps(facts)}', flush=True)
+
+def started(name):
+    global stage
+    stage = name
+    print(f'STARTED {stage}', flush=True)
+
+def normalized(text):
+    return ' '.join(text.split())
+
+class Document(HTMLParser):
+    def __init__(self, text):
+        super().__init__(convert_charrefs=True)
+        self.article = False
+        self.current = None
+        self.strong = None
+        self.blocks = []
+        self.emphasis = []
+        self.ids = []
+        self.labels = []
+        self.links = []
+        self.sections = []
+        self.feed(text)
+
+    def handle_starttag(self, tag, pairs):
+        attrs = dict(pairs)
+        if 'id' in attrs:
+            self.ids.append(attrs['id'])
+        if 'aria-labelledby' in attrs:
+            self.labels.extend(attrs['aria-labelledby'].split())
+        if tag == 'a':
+            self.links.append(attrs.get('href'))
+        if tag == 'article':
+            self.article = True
+        if self.article and tag == 'section':
+            self.sections.append(attrs.get('aria-labelledby'))
+        if self.article and tag in ('h1', 'h2', 'h3', 'p', 'li'):
+            assert self.current is None, 'Invalid nested content block'
+            self.current = [tag, '']
+        if self.article and tag == 'strong':
+            self.strong = ''
+        if self.current and tag == 'br':
+            self.current[1] += ' '
+
+    def handle_data(self, value):
+        if self.current is not None:
+            self.current[1] += value
+        if self.strong is not None:
+            self.strong += value
+
+    def handle_endtag(self, tag):
+        if self.article and tag in ('h1', 'h2', 'h3', 'p', 'li'):
+            assert self.current and self.current[0] == tag
+            self.blocks.append((tag, normalized(self.current[1])))
+            self.current = None
+        if self.article and tag == 'strong':
+            self.emphasis.append(self.strong)
+            self.strong = None
+        if tag == 'article':
+            self.article = False
+
+def expected_blocks(markdown):
+    expected = []
+    for block in re.split(r'\n\s*\n', markdown.strip()):
+        heading = re.match(r'^(#{1,3}) (.*)$', block)
+        if heading:
+            expected.append((f'h{len(heading[1])}', normalized(heading[2])))
+        elif block.startswith('- '):
+            expected.extend(('li', normalized(line[2:].replace('**', ''))) for line in block.splitlines())
+        else:
+            expected.append(('p', normalized(block.replace('**', ''))))
+    return expected
+
+def public_files(source):
+    tree = ast.parse(source)
+    for node in tree.body:
+        if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == 'PUBLIC_FILES' for t in node.targets):
+            return ast.literal_eval(node.value)
+    raise AssertionError('PUBLIC_FILES missing')
+
+server = None
+server_thread = None
+failure = None
+try:
+    started('approved_text_structure_and_emphasis')
+    approved = {}
+    documents = {}
+    for slug, digest in HASHES.items():
+        data = (DRAFTS / f'{slug}-approved-v1.1.md').read_bytes()
+        assert hashlib.sha256(data).hexdigest().upper() == digest
+        text = data.decode('utf-8')
+        document = Document((ROOT / f'{slug}.html').read_text(encoding='utf-8'))
+        expected = expected_blocks(text)
+        assert document.blocks == expected, f'{slug}: block-by-block text or paragraph mismatch'
+        assert document.emphasis == re.findall(r'\*\*(.*?)\*\*', text), f'{slug}: emphasis mismatch'
+        assert document.sections == [f'section-{number}' for number in range(1, 16)]
+        assert len(document.ids) == len(set(document.ids)), f'{slug}: duplicate IDs'
+        assert set(document.labels) <= set(document.ids)
+        assert sum(tag == 'h1' for tag, _ in expected) == 1
+        assert sum(tag == 'h2' for tag, _ in expected) == 15
+        assert sum(value.count('To be established upon publication') for _, value in document.blocks) == 2
+        assert not any(tag == 'h3' for tag, _ in expected) or slug == 'privacy-policy'
+        approved[slug] = expected
+        documents[f'{slug}.html'] = document
+        passed(slug + '_approved_fidelity', sections=15, blocks=len(expected),
+               paragraphs=sum(tag == 'p' for tag, _ in expected),
+               list_items=sum(tag == 'li' for tag, _ in expected), emphasis=len(document.emphasis), date_placeholders=2)
+
+    started('existing_page_preservation_and_local_links')
+    footer_pattern = rb'<footer>.*?</footer>'
+    for name in OLD:
+        before = (RUN / 'before' / name).read_bytes()
+        current = (ROOT / name).read_bytes()
+        assert re.sub(footer_pattern, b'', before, flags=re.S) == re.sub(footer_pattern, b'', current, flags=re.S), name + ': non-footer content changed'
+        if name not in ('confirm-email.html', 'manage-notifications.html'):
+            expected = before.replace(b'<a href="#">Privacy Policy</a>', b'<a href="privacy-policy.html">Privacy Policy</a>')
+            expected = expected.replace(b'<a href="#">Terms of Use</a>', b'<a href="terms-of-use.html">Terms of Use</a>')
+            assert current == expected, name + ': unexpected bytes changed'
+        documents[name] = Document(current.decode('utf-8'))
+    passed('all_existing_content_navigation_forms_and_consent_preserved', pages=len(OLD))
+
+    current_source = (ROOT / 'oaf_website/local_testing.py').read_text(encoding='utf-8')
+    before_source = (RUN / 'before/oaf_website/local_testing.py').read_text(encoding='utf-8')
+    expected_source = before_source.replace('    "manage-notifications.html", "assets/notification-management.js",',
+                                          '    "manage-notifications.html", "assets/notification-management.js",\n    "privacy-policy.html", "terms-of-use.html",')
+    assert current_source == expected_source
+    allowed = public_files(current_source)
+    assert allowed == public_files(before_source) + ('privacy-policy.html', 'terms-of-use.html')
+    assert all((ROOT / name).is_file() for name in allowed)
+    passed('public_file_allowlist_only_two_added_filenames', entries=len(allowed))
+
+    before_plan = (RUN / 'before/docs/WEBSITE_PLAN.md').read_bytes()
+    plan = (ROOT / 'docs/WEBSITE_PLAN.md').read_bytes()
+    assert plan.startswith(before_plan), 'Historical plan changed'
+    gate = plan[len(before_plan):].decode('utf-8')
+    assert all(value in gate for value in ('actual Effective Date and Last Updated dates', 'no date placeholders',
+                                         'Before public launch', 'legal review', 'provider', 'publication checks'))
+    passed('mandatory_launch_gate_appended_prior_plan_bytes_preserved', prior_bytes=len(before_plan))
+
+    links = set()
+    for name in PAGES:
+        for href in documents[name].links:
+            target = urlsplit(href)
+            if not target.scheme and not target.netloc:
+                filename = unquote(target.path) or name
+                assert filename in allowed, f'{name}: unresolved local link {href}'
+                assert (ROOT / filename).is_file()
+                if target.fragment:
+                    target_doc = documents.get(filename) or Document((ROOT / filename).read_text(encoding='utf-8'))
+                    assert target.fragment in target_doc.ids, f'{name}: unresolved fragment {href}'
+                links.add(filename)
+    passed('every_local_page_link_and_fragment_resolves', distinct_targets=len(links), pages=len(PAGES))
+
+    started('task_owned_loopback_server')
+    class Handler(SimpleHTTPRequestHandler):
+        def __init__(self, *args, **kwargs):
+            super().__init__(*args, directory=str(ROOT), **kwargs)
+
+        def send_head(self):
+            name = unquote(urlsplit(self.path).path).lstrip('/')
+            if name not in allowed:
+                self.send_error(404)
+                return None
+            return super().send_head()
+
+        def log_message(self, *args):
+            pass
+
+    server = ThreadingHTTPServer(('127.0.0.1', 0), Handler)
+    server_thread = Thread(target=server.serve_forever, daemon=True)
+    server_thread.start()
+    origin = f'http://127.0.0.1:{server.server_port}'
+    passed('temporary_server_started', origin=origin, public_files_only=True)
+
+    with sync_playwright() as pw:
+        browser = pw.chromium.launch(headless=True)
+        try:
+            context = browser.new_context(java_script_enabled=False, viewport={'width': 1280, 'height': 844})
+            page = context.new_page()
+            started('http_and_footer_clicks_all_ten_pages')
+            for name in allowed:
+                response = context.request.get(f'{origin}/{name}')
+                assert response.status == 200, f'{name}: HTTP {response.status}'
+            for name in PAGES:
+                for target, title in [('privacy-policy.html', 'Privacy Policy'), ('terms-of-use.html', 'Terms of Use')]:
+                    assert page.goto(f'{origin}/{name}').status == 200
+                    link = page.locator('footer a', has_text=title)
+                    assert link.count() == 1 and link.get_attribute('href') == target
+                    link.click()
+                    assert page.url == f'{origin}/{target}'
+                    assert page.locator('h1').inner_text() == title
+            passed('all_public_files_http_200_and_twenty_footer_clicks', files=len(allowed), footer_clicks=20)
+            context.close()
+
+            for width in (1280, 768, 390):
+                for slug in HASHES:
+                    started(f'{slug}_chromium_{width}')
+                    context = browser.new_context(viewport={'width': width, 'height': 844}, reduced_motion='reduce')
+                    page = context.new_page()
+                    errors, prohibited, failed_requests = [], [], []
+                    page.on('pageerror', lambda error: errors.append(type(error).__name__))
+                    page.on('console', lambda message: errors.append(message.type) if message.type == 'error' else None)
+                    page.on('requestfailed', lambda request: failed_requests.append(urlsplit(request.url).path))
+                    def guard(route):
+                        request = route.request
+                        target = urlsplit(request.url)
+                        if request.method != 'GET' or not request.url.startswith(origin + '/') or target.path.startswith('/api/'):
+                            prohibited.append({'method': request.method, 'path': target.path})
+                            route.abort()
+                        else:
+                            route.continue_()
+                    context.route('**/*', guard)
+                    assert page.goto(f'{origin}/{slug}.html', wait_until='networkidle').status == 200
+                    rendered = page.locator('article').evaluate('''article => [...article.querySelectorAll('h1,h2,h3,p,li')]
+                      .map(e => [e.tagName.toLowerCase(), e.innerText.replace(/\\s+/g, ' ').trim()])''')
+                    assert [tuple(block) for block in rendered] == approved[slug]
+                    layout = page.evaluate('''() => {
+                      const article = document.querySelector('article');
+                      const nodes = [...article.querySelectorAll('h1,h2,h3,p,li'), ...document.querySelectorAll('.site-header,footer,footer a')];
+                      const bad = nodes.filter(e => {const r=e.getBoundingClientRect(); return r.left < -1 || r.right > innerWidth+1 || e.scrollWidth > e.clientWidth+1;});
+                      const p = article.querySelector('p');
+                      return {width:innerWidth, scroll:document.documentElement.scrollWidth, bad:bad.map(e=>e.tagName),
+                        textSize:parseFloat(getComputedStyle(p).fontSize), lineHeight:parseFloat(getComputedStyle(p).lineHeight),
+                        contentWidth:document.querySelector('.legal-content .section-inner').getBoundingClientRect().width,
+                        h2:article.querySelectorAll('h2').length, h3:article.querySelectorAll('h3').length};
+                    }''')
+                    assert layout['scroll'] <= width and not layout['bad'], f'Horizontal overflow: {layout}'
+                    assert layout['textSize'] >= 16 and layout['lineHeight'] >= 1.5 * layout['textSize']
+                    assert layout['contentWidth'] <= 800
+                    headings = page.locator('article h1,article h2,article h3').evaluate_all('(nodes) => nodes.map(e => Number(e.tagName.slice(1)))')
+                    assert headings[0] == 1 and all(b <= a + 1 for a, b in zip(headings, headings[1:]))
+                    assert page.locator('article section').count() == 15
+                    assert page.locator('main').get_attribute('tabindex') == '-1'
+                    page.screenshot(path=str(RUN / f'{slug}-{width}-full.png'), full_page=True)
+                    page.screenshot(path=str(RUN / f'{slug}-{width}-top.png'))
+                    page.locator('#section-2' if slug == 'privacy-policy' else '#section-12').scroll_into_view_if_needed()
+                    page.screenshot(path=str(RUN / f'{slug}-{width}-section.png'))
+                    if slug == 'privacy-policy':
+                        page.locator('article ul').first.scroll_into_view_if_needed()
+                        page.screenshot(path=str(RUN / f'{slug}-{width}-list.png'))
+                    page.locator('footer').scroll_into_view_if_needed()
+                    page.screenshot(path=str(RUN / f'{slug}-{width}-footer.png'))
+
+                    # Keyboard entry, skip link, then all six header links and both footer links.
+                    page.goto('about:blank')
+                    page.goto(f'{origin}/{slug}.html', wait_until='networkidle')
+                    page.keyboard.press('Tab')
+                    assert page.locator(':focus').get_attribute('class') == 'button legal-skip-link'
+                    focus = page.locator(':focus').evaluate('''e => ({visible:e.matches(':focus-visible'),
+                      outline:getComputedStyle(e).outlineStyle, top:e.getBoundingClientRect().top})''')
+                    assert focus['visible'] and focus['outline'] != 'none' and focus['top'] >= 0
+                    page.keyboard.press('Enter')
+                    assert page.locator(':focus').get_attribute('id') == 'main-content'
+                    page.goto('about:blank')
+                    page.goto(f'{origin}/{slug}.html', wait_until='networkidle')
+                    visited = []
+                    for index in range(9):
+                        page.keyboard.press('Tab')
+                        node = page.locator(':focus')
+                        href = node.get_attribute('href')
+                        visited.append(href)
+                        info = node.evaluate('''e => {
+                          const r=e.getBoundingClientRect(), s=getComputedStyle(e), header=document.querySelector('.site-header').getBoundingClientRect();
+                          return {visible:e.matches(':focus-visible'),outline:s.outlineStyle,width:parseFloat(s.outlineWidth),
+                            left:r.left,right:r.right,top:r.top,bottom:r.bottom,headerBottom:header.bottom,
+                            footer:!!e.closest('footer')};
+                        }''')
+                        assert info['visible'] and info['outline'] != 'none' and info['width'] >= 2
+                        assert info['left'] >= 0 and info['right'] <= width and info['top'] >= 0 and info['bottom'] <= 844
+                        if info['footer']:
+                            assert info['top'] >= info['headerBottom'], 'Footer keyboard focus hidden behind sticky header'
+                    assert visited == ['#main-content', 'index.html', 'about.html', 'gramanna.html', 'faq.html',
+                                       'contact.html', 'support.html', 'privacy-policy.html', 'terms-of-use.html']
+                    assert not errors and not prohibited and not failed_requests, f'Browser errors: {errors}; blocked: {prohibited}; requests: {failed_requests}'
+                    passed(f'{slug}_{width}', **layout, keyboard_links=9, console_errors=0, external_or_write_requests=0)
+                    context.close()
+        finally:
+            browser.close()
+    passed('browser_contexts_and_task_chromium_closed')
+except Exception as error:

def luminance(rgb):
    values = [int(v) / 255 for v in re.findall(r'\d+', rgb)[:3]]
    linear = [v / 12.92 if v <= .04045 else ((v + .055) / 1.055) ** 2.4 for v in values]
    return sum(a * b for a, b in zip(linear, (.2126, .7152, .0722)))

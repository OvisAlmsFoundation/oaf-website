+        server_thread.join(timeout=5)
+        assert not server_thread.is_alive(), 'Temporary server thread remained active'
+        passed('task_owned_temporary_server_stopped')
+    result = {'status': 'ERROR' if failure else 'PASS', 'first_failure': failure,
+              'checks': results, 'not_run': ['live forms/provider/email/database operations', 'canonical test campaign', 'deployment'],
+              'cleanup': 'Only task-owned browser and temporary server closed'}
+    with (RUN / 'focused-results.json').open('x', encoding='utf-8') as stream:
+        json.dump(result, stream, indent=2)
+sys.exit(1 if failure else 0)

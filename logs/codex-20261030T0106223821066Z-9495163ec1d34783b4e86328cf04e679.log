+    passed('browser_contexts_and_task_chromium_closed')
+except Exception as error:
+    failure = {'stage': stage, 'exception_class': type(error).__name__, 'safe_detail': str(error)}
+    print('FIRST_FAILURE ' + json.dumps(failure), flush=True)
+    traceback.print_exc()
+finally:
+    if server is not None:
+        server.shutdown()

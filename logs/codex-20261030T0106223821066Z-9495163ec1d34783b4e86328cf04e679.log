def audit(page, selector, text, kind, shot):
    global stage, failure_facts
    stage = f'{shot}_{page.viewport_size["width"]}'
    failure_facts = dict(selector=selector, expected_text=text, expected_status=kind)
    node = page.locator(selector)
    expect(node).to_have_text(text)
    expect(node).to_have_attribute('data-status', kind)
    expect(node).to_have_attribute('role', 'alert' if kind == 'error' else 'status')
    node.scroll_into_view_if_needed()
    observed = node.evaluate('''e => {
      const s = getComputedStyle(e), icon = getComputedStyle(e, '::before'), r = e.getBoundingClientRect();
      return {color:s.color, background:s.backgroundColor, font:parseFloat(s.fontSize), weight:s.fontWeight,
        border:s.borderTopStyle, borderColor:s.borderTopColor, icon:icon.maskImage,
        width:r.width, left:r.left, right:r.right, client:e.clientWidth, scroll:e.scrollWidth,
        pageWidth:document.documentElement.scrollWidth, viewport:innerWidth,
        atomic:e.getAttribute('aria-atomic'), live:e.getAttribute('aria-live')};
    }''')
    a, b = sorted((luminance(observed['color']), luminance(observed['background'])))
    ratio = (b + .05) / (a + .05)
    assert ratio >= 4.5, 'text_contrast'
    a, b = sorted((luminance(observed['borderColor']), luminance(observed['background'])))
    assert (b + .05) / (a + .05) >= 3, 'border_contrast'
    assert observed['font'] >= 16 and int(observed['weight']) >= 700, 'prominent_text'
    assert observed['icon'] != 'none' and observed['atomic'] == 'true', 'icon_and_atomic_region'
    assert observed['live'] in ('assertive', None) if kind == 'error' else observed['live'] == 'polite'
    assert observed['left'] >= 0 and observed['right'] <= observed['viewport'] + 1, 'message_bounds'
    assert observed['scroll'] <= observed['client'] + 1, 'message_overflow'
    assert observed['pageWidth'] <= observed['viewport'], 'page_overflow'
    if kind == 'processing':
        assert observed['border'] == 'dashed', 'processing_shape'
    # Accessible names contain the original text, without decorative icon glyphs.
    assert text in node.aria_snapshot(), 'accessible_message_text'
    target = page.locator('#notification-management') if selector.startswith('#management') else page.locator('.notification-preview')
    page.evaluate('window.scrollTo(0, 0)')
    page.screenshot(path=str(ARTIFACTS / f'{shot}-{page.viewport_size["width"]}.png'), full_page=True)
    results.append({'check':shot, 'width':page.viewport_size['width'], 'pass':True, 'contrast':round(ratio, 2)})
    print(f'PASS {shot} {page.viewport_size["width"]}px contrast={ratio:.2f}', flush=True)

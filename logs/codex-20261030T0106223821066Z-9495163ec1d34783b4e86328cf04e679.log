+    'privacy-policy': '0D3AC043A27E42E868F6E3E914409D6B0947C96BE84BFDEA9AE1971D6FE8CAB8',
+    'terms-of-use': '5BB4BFBF36148951ED24B37DF5116D4FE7218B8A19D5EAC35DDACFD8197AC798',
+}
+PAGES = ['index.html', 'about.html', 'gramanna.html', 'faq.html', 'contact.html', 'support.html',
+         'confirm-email.html', 'manage-notifications.html']
+
+print('STARTED approved_source_hashes', flush=True)
+draft_text = {}
+for slug, expected in SOURCES.items():
+    source = (DRAFTS / f'{slug}-approved-v1.1.md').read_bytes()
+    assert hashlib.sha256(source).hexdigest().upper() == expected, f'{slug}: approved hash mismatch'
+    draft_text[slug] = source.decode('utf-8')
+    assert len(re.findall(r'^## \d+\. ', draft_text[slug], re.M)) == 15
+    assert not (ROOT / f'{slug}.html').exists(), f'{slug}: output already exists'
+print('PASS both supplied hashes; 15 sections each', flush=True)
+
+print('STARTED preserve_current_files', flush=True)
+names = PAGES + ['styles.css', 'docs/WEBSITE_PLAN.md', 'oaf_website/local_testing.py']
+baseline = {}
+for name in names:
+    data = (ROOT / name).read_bytes()
+    destination = RUN / 'before' / name
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    with destination.open('xb') as stream:
+        stream.write(data)
+    baseline[name] = hashlib.sha256(data).hexdigest()
+with (RUN / 'baseline.json').open('x', encoding='utf-8') as stream:
+    json.dump(baseline, stream, indent=2)
+print('PASS exact-byte backups of direct consumers', flush=True)
+
+def inline(value):
+    return re.sub(r'\*\*(.+?)\*\*', r'<strong>\1</strong>', html.escape(value, quote=False))
+
+def blocks(value):
+    result = []
+    for block in value.strip().split('\n\n'):
+        if block.startswith('### '):
+            result.append(f'          <h3>{inline(block[4:])}</h3>')
+        elif block.startswith('- '):
+            items = block.splitlines()
+            assert all(item.startswith('- ') for item in items), 'Unexpected list structure'
+            result.append('          <ul>\n' + '\n'.join(f'            <li>{inline(item[2:])}</li>' for item in items) + '\n          </ul>')
+        else:
+            assert not block.startswith('#'), 'Unexpected heading'
+            result.append('          <p>' + '<br>\n            '.join(inline(line) for line in block.splitlines()) + '</p>')
+    return '\n\n'.join(result)
+

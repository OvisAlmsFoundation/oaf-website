    def allow(self, permission):
        with self.lock:
            now = self.clock()
            start, used = self.windows.get(permission, (now, 0))
            if now - start >= 60:
                start, used = now, 0
            limit = 120 if permission == "submission" else 30
            if used >= limit:
                return False
            self.windows[permission] = (start, used + 1)
            return True

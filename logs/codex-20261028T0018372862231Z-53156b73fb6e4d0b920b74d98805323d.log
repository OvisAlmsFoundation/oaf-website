def unpack(arc):
    if not isinstance(arc,int): return tuple(arc)
    first,second=arc&0xFFFFFFF,(arc>>28)&0xFFFFFFF
    return (-first if arc&(1<<56) else first,-second if arc&(1<<57) else second)

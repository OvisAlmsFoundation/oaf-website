diff --git a/tests/test_notification_dispatch.py b/tests/test_notification_dispatch.py
index 10f0f613503bcc3aedcdb05bf699c18845533135..3714efc9522d934abcac9cfa49d65afd3404c4d6
--- a/tests/test_notification_dispatch.py

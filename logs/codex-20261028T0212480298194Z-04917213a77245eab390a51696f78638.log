function Initialize-TaskUI {
    # Reuse exactly the existing alert function; never execute the profile body.
    $taskProfile = Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'WindowsPowerShell\Microsoft.PowerShell_profile.ps1'
    if (-not (Test-Path -LiteralPath $taskProfile -PathType Leaf)) { throw 'Unavailable alert.' }
    $taskTokens = $null
    $taskErrors = $null
    $taskAst = [System.Management.Automation.Language.Parser]::ParseFile($taskProfile, [ref]$taskTokens, [ref]$taskErrors)
    if ($taskErrors.Count -ne 0) { throw 'Invalid alert profile.' }
    $taskDefinitions = @($taskAst.FindAll({ param($taskNode)
        $taskNode -is [System.Management.Automation.Language.FunctionDefinitionAst] -and
        $taskNode.Name -ceq 'Show-OAFPowerShellAlert'
    }, $false))
    if ($taskDefinitions.Count -ne 1) { throw 'Unavailable alert function.' }
    . ([ScriptBlock]::Create($taskDefinitions[0].Extent.Text))
    Set-Item -Path Function:script:Show-OAFPowerShellAlert -Value (Get-Item Function:Show-OAFPowerShellAlert).ScriptBlock
    $script:taskAlertReady = $true
    if (-not (Get-Command Set-Clipboard -ErrorAction SilentlyContinue) -or
        -not (Get-Command Get-Clipboard -ErrorAction SilentlyContinue)) { throw 'Unavailable clipboard.' }
}
System.Management.Automation.RemoteException
function Copy-TaskReport {
    $taskReport = $taskLines -join [Environment]::NewLine
    Set-Clipboard -Value $taskReport
    $taskCopied = Get-Clipboard -Raw
    if ($null -eq $taskCopied -or $taskCopied.TrimEnd("`r", "`n") -cne $taskReport) {
        throw 'Clipboard report verification failed.'
    }
}

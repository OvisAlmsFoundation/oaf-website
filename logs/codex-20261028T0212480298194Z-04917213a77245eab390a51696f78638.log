System.Management.Automation.RemoteException
function Write-TaskLine([string]$Line) {
    $script:taskLines.Add($Line)
    Write-Host $Line
    if ($null -ne $script:taskWriter) {
        try { $script:taskWriter.WriteLine($Line); $script:taskWriter.Flush() }
        catch {
            $script:taskLogHealthy = $false
            $script:taskExitCode = 2
            # Do not echo filesystem exceptions or recurse into a failed writer.
            Write-Host 'LOG | BLOCKED | sanitized_log_write_failure'
            $script:taskLines.Add('LOG | BLOCKED | sanitized_log_write_failure')
        }
    }
}
System.Management.Automation.RemoteException
function Receive-TaskLine([string]$Line) {
    $taskAccept = $false
    if (-not $script:taskTerminal) {
        if ($taskExpectedPass -ccontains $Line) {
            if ($script:taskBlocked) {
                # Once blocked, accept only truthful cleanup acknowledgments.
                $taskAccept = $Line -cmatch '^(VERIFICATION_ROLLBACK|LOCK_RELEASE|UNLOCK_ROLLBACK|CONNECTION_CLOSE|ENGINE_DISPOSE) \| PASS \| '
            } elseif ($script:taskPassIndex -lt $taskExpectedPass.Count -and
                $Line -ceq $taskExpectedPass[$script:taskPassIndex]) {
                $script:taskPassIndex++
                $taskAccept = $true
            }
            if ($taskAccept -and $Line.StartsWith('RESULT | PASS | ')) { $script:taskTerminal = $true }
        } elseif ($Line -cmatch '^(CHECK|CLEANUP|VERIFICATION_ROLLBACK|LOCK_RELEASE|UNLOCK_ROLLBACK|CONNECTION_CLOSE|ENGINE_DISPOSE|RESULT) \| BLOCKED \| ([a-z0-9_]+)$' -and
            $taskFailureCodes -ccontains $Matches[2]) {
            $script:taskBlocked = $true
            $taskAccept = $true
            if ($Line.StartsWith('RESULT | BLOCKED | ')) { $script:taskTerminal = $true }
        } elseif ($script:taskBlocked -and $Line -ceq 'LOCK_ABSENCE | PASS | original session confirms no owned advisory lock after unsuccessful acquisition') {
            $taskAccept = $true
        }
    }
    if ($taskAccept) { Write-TaskLine $Line }
    else {
        $script:taskRejected = $true
        Write-TaskLine 'OUTPUT | BLOCKED | unexpected_native_output_redacted'
    }
}
System.Management.Automation.RemoteException
function Test-TaskNativeResult([int]$NativeExit) {
    return ($NativeExit -eq 0 -and -not $taskRejected -and -not $taskBlocked -and
        $taskTerminal -and $taskPassIndex -eq $taskExpectedPass.Count -and $taskLogHealthy)
}

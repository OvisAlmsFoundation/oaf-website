def main(argv=None):
    # Silence library logging/warnings; native crash/stderr is separately rejected by PS.
    logging.disable(logging.CRITICAL)
    warnings.simplefilter('ignore')
    args = sys.argv[1:] if argv is None else argv
    if args != ['--owner-read-only']:
        emit('RESULT', 'BLOCKED', 'owner_execution_flag_required')
        return 2
    return run_verification()

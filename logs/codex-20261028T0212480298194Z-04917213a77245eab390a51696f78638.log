class Session:
    """Native physical-session proof, with no reconnect or replacement connection."""
    def __init__(self, connection):
        self.connection = connection
        require(not connection.closed and not connection.invalidated, config.Failure.CONNECTION)
        self.proxy = connection.connection
        self.dbapi = self.proxy.dbapi_connection
        self.driver = self.proxy.driver_connection
        self.pgconn = self.driver.pgconn
        self.backend = self.driver.info.backend_pid
        self.rollback_uncertain = False
        self.guard()
System.Management.Automation.RemoteException
    def guard(self):
        c = self.connection
        # Check before accessing c.connection, which could otherwise reconnect.
        require(not c.closed and not c.invalidated and self.proxy.is_valid,
                config.Failure.CONNECTION)
        proxy = c.connection
        require(proxy is self.proxy and proxy.dbapi_connection is self.dbapi
                and proxy.driver_connection is self.driver and not self.driver.closed
                and not self.driver.broken and self.driver.pgconn is self.pgconn
                and type(self.backend) is int and self.driver.info.backend_pid == self.backend,
                config.Failure.CONNECTION)
System.Management.Automation.RemoteException
    def limits(self):
        self.guard()
        require(not self.connection.in_transaction(), config.Failure.TRANSACTION)
        self.connection.begin()
        _set_limits(self.connection, readonly=True)
        require(validation.scalar(self.connection,
                    "SELECT pg_catalog.current_setting('transaction_read_only')") == 'on'
                and validation.scalar(self.connection,
                    "SELECT pg_catalog.current_setting('default_transaction_read_only')") == 'on',
                'read_only_not_confirmed')
        self.guard()
System.Management.Automation.RemoteException
    def rollback(self):
        require(not self.rollback_uncertain, 'cleanup_unconfirmed')
        self.guard()
        require(self.connection.in_transaction(), 'cleanup_unconfirmed')
        self.rollback_uncertain = True
        self.connection.rollback()
        self.guard()
        require(not self.connection.in_transaction()
                and self.driver.info.transaction_status == TransactionStatus.IDLE,
                'cleanup_unconfirmed')
        self.rollback_uncertain = False
System.Management.Automation.RemoteException
    def owns_lock(self):
        self.guard()
        return validation.scalar(self.connection, """
            SELECT EXISTS (SELECT 1 FROM pg_catalog.pg_locks
                WHERE locktype='advisory' AND pid=pg_catalog.pg_backend_pid()
                  AND database=(SELECT oid FROM pg_catalog.pg_database
                                WHERE datname=pg_catalog.current_database())
                  AND classid=:namespace AND objid=:resource AND objsubid=2
                  AND mode='ExclusiveLock' AND granted)

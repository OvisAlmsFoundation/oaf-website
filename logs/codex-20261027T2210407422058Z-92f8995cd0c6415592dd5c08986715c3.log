'@
    $taskMode = if ($ValidateOnly) { 'validate' } else { 'owner' }
    $ErrorActionPreference = 'Continue'
    $taskCode | & (Join-Path $taskRoot '.venv\Scripts\python.exe') -B -u - $taskMode $PSCommandPath $taskRunId 2>&1 | ForEach-Object {
        $taskLine = [string]$_
        Write-TaskLine $taskLine
        if ($taskLine.StartsWith('FIRST_FAILURE | ')) { $script:taskFirstFailure = $taskLine }
        if ($taskLine -ceq 'RESULT | OFFLINE_VALIDATED' -or $taskLine -ceq 'RESULT | APPLIED_AND_VERIFIED') { $script:taskOutcome = $taskLine.Substring(9) }
    } -ErrorAction Stop
    $taskNativeExit = $LASTEXITCODE; $ErrorActionPreference = 'Stop'
    Write-TaskLine ('NATIVE_EXIT | embedded_python | ' + $taskNativeExit)
    $taskExpected = if ($ValidateOnly) { 'OFFLINE_VALIDATED' } else { 'APPLIED_AND_VERIFIED' }
    if ($taskNativeExit -ne 0 -or $taskOutcome -cne $taskExpected) { throw 'native_outcome_unconfirmed_preserve_evidence_no_retry' }
    $taskExit = 0
} catch {
    $ErrorActionPreference = 'Stop'; $taskExit = 2
    if ($null -eq $taskFirstFailure) {
        $taskFirstFailure = 'FIRST_FAILURE | phase=' + $taskPhase + ' | expected=complete verified gate | observed=unavailable_or_rejected | exception=' + $_.Exception.GetType().Name + ' | hresult=' + ('0x{0:X8}' -f $_.Exception.HResult)
        # Emit only our fixed literal reason; never render unrestricted exception messages.
        if ($_.Exception.Message -match '^[a-z0-9_]+$') { $taskFirstFailure += ' | predicate=' + $_.Exception.Message }
        try { Write-TaskLine $taskFirstFailure; Write-TaskLine 'NOT_RUN | dependent approval/issuance/execution/evidence stages | dependency=first failure; an unfinished STARTED is INTERRUPTED/UNKNOWN' } catch { Write-Host $taskFirstFailure }
    }
} finally {
    if ($taskHeld) { try { $taskMutex.ReleaseMutex() } catch { $taskExit = 2; try { Write-TaskLine 'ERROR | mutex_release_unconfirmed' } catch {} } }
    if ($null -ne $taskMutex) { $taskMutex.Dispose() }
    try {
        $taskPhase = 'reporting_finalization'
        Write-TaskLine ('STARTED | ' + $taskPhase)
        $taskStatus = if ($taskExit -eq 0) { 'PASS' } else { 'BLOCKED' }
        $taskReport = "PROJECT: OAF WEBSITE`r`nTASK: WU1 - TESTING Migration 0007`r`nSTATUS: " + $taskStatus + "`r`n`r`nRun: " + $taskRunId + "`r`nOutcome: " + $taskOutcome + "`r`nNative exit: " + $taskNativeExit + "`r`nSource: " + $PSCommandPath + "`r`nLog: " + $taskLog + "`r`nFirst failure: " + $(if ($null -eq $taskFirstFailure) { 'NONE' } else { $taskFirstFailure }) + "`r`nSingle next safe checkpoint: " + $(if ($ValidateOnly -and $taskExit -eq 0) { 'Deliberate owner invocation of this exact source.' } else { 'Review this attempt and published audit evidence read-only. No rerun or reissuance.' }) + "`r`n`r`n" + ($taskLines -join "`r`n")
        $taskReportPath = Join-Path $PSScriptRoot ($taskRunId + '-REPORT.txt')
        $taskReportStream = New-Object IO.FileStream($taskReportPath, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::Read)
        try { $taskBytes = (New-Object Text.UTF8Encoding($false)).GetBytes($taskReport); $taskReportStream.Write($taskBytes,0,$taskBytes.Length); $taskReportStream.Flush($true) } finally { $taskReportStream.Dispose() }
        if ([IO.File]::ReadAllText($taskReportPath) -cne $taskReport) { throw 'report_readback_failed' }
        $taskWriter.Dispose(); $taskWriter = $null
        if ([IO.File]::ReadAllText($taskLog) -cne (($taskLines -join [Environment]::NewLine) + [Environment]::NewLine)) { throw 'live_log_readback_failed' }
        $taskCompletion = [ordered]@{run=$taskRunId; status=$taskStatus; outcome=$taskOutcome; native_exit=$taskNativeExit; source_sha256=(Get-FileHash -LiteralPath $PSCommandPath -Algorithm SHA256).Hash.ToLowerInvariant(); log_readback=$true; report_readback=$true; final_delivery='Invoke-OAFCodex'; first_failure=$taskFirstFailure}
        $taskCompletionPath = Join-Path $PSScriptRoot ($taskRunId + '-completion.json')
        $taskCompletionStream = New-Object IO.FileStream($taskCompletionPath, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::Read)
        try { $taskBytes = (New-Object Text.UTF8Encoding($false)).GetBytes(($taskCompletion | ConvertTo-Json)); $taskCompletionStream.Write($taskBytes,0,$taskBytes.Length); $taskCompletionStream.Flush($true) } finally { $taskCompletionStream.Dispose() }
        Write-Host $taskReport
        Write-Host ('PASS | reporting_finalization | log/report read-back verified; final clipboard/visual delivery belongs solely to Invoke-OAFCodex | ' + $taskCompletionPath)
    } catch {
        $taskExit = 2
        $taskReportingFailure = 'REPORTING INCOMPLETE | phase=' + $taskPhase + ' | exception=' + $_.Exception.GetType().Name + ' | hresult=' + ('0x{0:X8}' -f $_.Exception.HResult) + ' | Retain terminal/logs; inspect audit read-only. No rerun or reissuance.'
        Write-Host $taskReportingFailure
        try {
            $taskFailurePath = Join-Path $PSScriptRoot ($taskRunId + '-REPORTING-INCOMPLETE.txt')
            $taskFailureStream = New-Object IO.FileStream($taskFailurePath, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::Read)
            try { $taskBytes = (New-Object Text.UTF8Encoding($false)).GetBytes(($taskLines -join "`r`n") + "`r`n" + $taskReportingFailure); $taskFailureStream.Write($taskBytes,0,$taskBytes.Length); $taskFailureStream.Flush($true) } finally { $taskFailureStream.Dispose() }
            Write-Host ('EVIDENCE | ' + $taskFailurePath)
        } catch { Write-Host 'REPORTING INCOMPLETE | failure record unavailable; retain terminal and existing log' }
        if ($null -ne $taskWriter) { $taskWriter.Dispose(); $taskWriter = $null }
    }
}
exit $taskExit

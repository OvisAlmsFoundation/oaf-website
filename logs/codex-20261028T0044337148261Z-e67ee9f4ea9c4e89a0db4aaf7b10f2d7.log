    original = getattr(error, "orig", error)
    code = getattr(original, "sqlstate", None)
    rejected = {
        "40001": Failure.SERIALIZATION, "40P01": Failure.DEADLOCK,
        "57014": Failure.STATEMENT_TIMEOUT, "55P03": Failure.LOCK_BUSY,
    }
    if committing:

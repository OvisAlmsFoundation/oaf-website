+
+
+def emit(status, **details):
+    record = dict(utc=datetime.now(timezone.utc).isoformat(), run_id=EVIDENCE.name, attempt=3,
+                  operation=OPERATION, status=status, **details)
+    line = json.dumps(record)
+    print(line, flush=True)
+    with (EVIDENCE / 'focused.log').open('a', encoding='utf-8') as out:
+        out.write(line + '\n')
+
+
+SNAPSHOT = """() => {
+  const box = el => { const r = el.getBoundingClientRect();
+    return {x:r.x,y:r.y,width:r.width,height:r.height,right:r.right,bottom:r.bottom}; };
+  const styles = (el, pseudo=null) => { const css = getComputedStyle(el,pseudo);
+    return Object.fromEntries([...css].map(k => [k,css.getPropertyValue(k)])); };
+  const img = document.querySelector('.hero-image img');
+  const hero = document.querySelector('.hero');
+  const wrapper = document.querySelector('.hero-image');
+  return {
+    layout: [...document.querySelectorAll('body, body *')].map(el => ({
+      tag:el.tagName, classes:el.className, box:box(el), styles:styles(el),
+      before:styles(el,'::before'), after:styles(el,'::after')})),
+    hero:box(hero), imageBox:box(img), wrapper:box(wrapper),
+    mask:getComputedStyle(wrapper).maskImage,
+    objectFit:getComputedStyle(img).objectFit,
+    objectPosition:getComputedStyle(img).objectPosition,
+    natural:[img.naturalWidth,img.naturalHeight],
+    loaded:img.complete && img.naturalWidth>0,
+    source:img.getAttribute('src'),
+    documentWidth:document.documentElement.scrollWidth,
+    viewport:innerWidth,
+    headline:document.querySelector('.hero h1').innerText,
+    supporting:document.querySelector('.hero p').innerText,
+    textBoxes:[...document.querySelectorAll('.hero h1,.hero p')].map(box)
+  };
+}"""
+
+
+try:
+    emit('STARTED')
+    before = (EVIDENCE / 'index.before.html').read_bytes()
+    current = (ROOT / 'index.html').read_bytes()
+    assert current == before.replace(META['original_src'].encode(), META['new_src'].encode(), 1), 'Unexpected homepage edit'
+    assert (ROOT / 'styles.css').read_bytes() == (EVIDENCE / 'styles.before.css').read_bytes(), 'Styles changed'
+    for name, digest in META['preserved'].items():
+        assert hashlib.sha256((ROOT / name).read_bytes()).hexdigest() == digest, f'Owner file changed: {name}'
+    assert hashlib.sha256((ROOT / META['new_src']).read_bytes()).hexdigest() == META['asset_sha256'], 'Image mismatch'
+    emit('PASS', homepage_edit='one image source only', styles='byte-identical', owner_files='unchanged')
+
+    with sync_playwright() as playwright:
+        browser = playwright.chromium.launch(headless=True)
+        try:
+            for width in (390,):
+                OPERATION = f'chromium_{width}'
+                emit('STARTED')
+                context = browser.new_context(viewport={'width': width, 'height': 900}, device_scale_factor=1)
+                mode = {'baseline': True}
+                errors, unexpected, responses = [], [], []
+                allowed = {'index.html', 'styles.css', META['original_src'], META['new_src'], 'assets/images/gramanna-logo.png'}
+
+                def intercept(route):
+                    parts = urlsplit(route.request.url)
+                    name = parts.path.lstrip('/')
+                    if parts.netloc != 'website.example' or name not in allowed:
+                        unexpected.append(route.request.url)
+                        route.abort()
+                        return
+                    data = before if name == 'index.html' and mode['baseline'] else (ROOT / name).read_bytes()
+                    mime = 'text/html' if name.endswith('.html') else 'text/css' if name.endswith('.css') else 'image/png' if name.endswith('.png') else 'image/webp'
+                    route.fulfill(status=200, content_type=mime, body=data)
+
+                context.route('**/*', intercept)
+                page = context.new_page()
+                page.on('pageerror', lambda error: errors.append(str(error)))
+                page.on('console', lambda message: errors.append(message.text) if message.type == 'error' else None)
+                page.on('response', lambda response: responses.append({'path': urlsplit(response.url).path, 'status': response.status}))
+                snapshots = {}
+                for label, baseline in (('before', True), ('after', False)):
+                    mode['baseline'] = baseline
+                    page.goto(ORIGIN + '/index.html', wait_until='networkidle')
+                    page.locator('.hero-image img').evaluate('img => img.decode()')
+                    page.evaluate('document.fonts.ready')
+                    page.evaluate('window.scrollTo(0,0)')
+                    data = page.evaluate(SNAPSHOT)
+                    snapshots[label] = data
+                    assert data['loaded'], f'{label}: hero not loaded'
+                    assert data['documentWidth'] == width, f'{label}: horizontal overflow'
+                    assert data['objectFit'] == 'cover' and data['objectPosition'] == '50% 50%', 'Crop rule changed'
+                    assert '18%' in data['mask'] and '88%' in data['mask'], 'Fade stops missing'
+                    # Chromium omits the default "to bottom" direction in computed CSS.
+                    if width == 1280:
+                        assert 'to right' in data['mask'], data['mask']
+                    else:
+                        assert 'to right' not in data['mask'], data['mask']
+                    assert all(r['x'] >= 0 and r['right'] <= width and r['y'] >= data['hero']['y'] and r['bottom'] <= data['hero']['bottom'] for r in data['textBoxes']), f'{label}: clipped text'
+                    page.screenshot(path=str(OUTPUT / f'{label}-{width}.png'), full_page=True, animations='allow')
+                    page.locator('.hero').screenshot(path=str(OUTPUT / f'{label}-hero-{width}.png'), animations='allow')
+                assert snapshots['before']['layout'] == snapshots['after']['layout'], 'Computed styles or page geometry changed'
+                assert snapshots['after']['source'] == META['new_src']
+                assert snapshots['after']['natural'] == META['asset_dimensions']
+                for key in ('headline', 'supporting'):
+                    assert snapshots['before'][key] == snapshots['after'][key], 'Text changed'
+                first = Image.open(OUTPUT / f'before-{width}.png').convert('RGB')
+                last = Image.open(OUTPUT / f'after-{width}.png').convert('RGB')
+                diff = ImageChops.difference(first, last).getbbox()
+                assert diff, 'Replacement produced no visual change'
+                hero = snapshots['after']['hero']
+                assert diff[1] >= int(hero['y']) and diff[3] <= int(hero['bottom'] + 1), 'Pixels outside hero changed'
+
+                # Compare image edge pixels with the actual hero background in memory.
+                image = page.locator('.hero-image')
+                image.evaluate("el => el.style.visibility = 'hidden'")
+                page.screenshot(path=str(OUTPUT / f'background-{width}.png'), full_page=True)
+                image.evaluate("el => el.removeAttribute('style')")
+                background = Image.open(OUTPUT / f'background-{width}.png').convert('RGB')
+                rect = snapshots['after']['wrapper']
+                x, y = round(rect['x']), round(rect['y'])
+                right, bottom = round(rect['right']), round(rect['bottom'])
+                edges = {'left': (x, y, x+1, bottom), 'right': (right-1, y, right, bottom)} if width == 1280 else {'top': (x, y, right, y+1), 'bottom': (x, bottom-1, right, bottom)}
+                edge_deltas = {}
+                for edge, region in edges.items():
+                    delta = ImageChops.difference(last.crop(region), background.crop(region))
+                    edge_deltas[edge] = round(max(ImageStat.Stat(delta).mean), 3)
+                    assert edge_deltas[edge] <= 4, f'{edge}: fade no longer meets background'
+                assert not unexpected, unexpected
+                assert not errors, errors
+                assert {'path': '/' + META['new_src'], 'status': 200} in responses, 'Image response not 200'
+                result = dict(width=width, image_status=200, natural=snapshots['after']['natural'],
+                              mask=snapshots['after']['mask'], edge_background_deltas=edge_deltas,
+                              computed_styles_and_geometry='identical', outside_hero_pixels='identical',
+                              horizontal_overflow=False, errors=errors, unexpected_requests=unexpected)
+                RESULTS.append(result)
+                (OUTPUT / f'computed-{width}.json').write_text(json.dumps(snapshots, indent=2), encoding='utf-8')
+                emit('PASS', **result)
+                context.close()
+        finally:
+            browser.close()
+    OPERATION = 'focused_validation'
+    initial_failure = json.loads((EVIDENCE / 'first-failure.json').read_text(encoding='utf-8'))
+    (OUTPUT / 'results.json').write_text(json.dumps(dict(status='PASS', initial_failure=initial_failure, resolution='Existing homepage logo added to intercepted asset allowlist; Chromium default gradient serialization accepted. No product fixes required. Desktop PASS retained from attempt 2; mobile checked in attempt 3.', results=RESULTS), indent=2), encoding='utf-8')
+    emit('PASS', native_exit=0, first_failure='attempt-1 retained; test allowlist and default gradient serialization corrected', evidence=str(OUTPUT))
+except Exception as exc:
+    emit('ERROR', exception_class=type(exc).__name__, reason=str(exc), completed=RESULTS, native_exit=1)
+    failure = dict(status='ERROR', operation=OPERATION, exception_class=type(exc).__name__, reason=str(exc), completed=RESULTS)
+    failure_path = OUTPUT / 'first-failure.json'
+    if not failure_path.exists():
+        with failure_path.open('x', encoding='utf-8') as out:
+            json.dump(failure, out, indent=2)
+    sys.exit(1)

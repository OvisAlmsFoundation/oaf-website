function Invoke-TaskPython([string]$Mode) {
    $taskPythonCode | & $taskPython -B - $Mode 2>&1 | ForEach-Object { Write-TaskLine ([string]$_) }
    if ($LASTEXITCODE -ne 0) { throw ('Record-only ' + $Mode + ' failed; stop without retry.') }
}

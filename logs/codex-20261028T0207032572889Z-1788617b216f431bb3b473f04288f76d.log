def read_claim6():
    # audit_destination() may mkdir; do not call it. Reuse protected readers only.
    local = os.environ.get('LOCALAPPDATA')
    require(isinstance(local, str) and Path(local).is_absolute(), 'claim6_identity_mismatch')
    root = Path(local) / 'OAF Website/BootstrapAudit/MigrationAudit'
    require(root == AUDIT_ROOT and root.resolve() == root and root.is_dir(), 'claim6_identity_mismatch')
    for path in (root.parent, root):
        require(not path.lstat().st_file_attributes & stat.FILE_ATTRIBUTE_REPARSE_POINT,
                'claim6_identity_mismatch')
    require(authority._previous(root, 'testing') == {'sequence': 6, 'sha256': CLAIM_HASH},
            'claim6_identity_mismatch')
    claim, digest = authority._read(root / 'claim-testing-00000006.json')
    require(digest == CLAIM_HASH and claim.get('format') == 1
            and claim.get('kind') == 'authorization_claimed'
            and claim.get('run_id') == FAILED_RUN
            and claim.get('authorization_id') == CONSUMED_AUTHORIZATION
            and claim.get('request', {}).get('environment') == 'testing'
            and claim.get('request', {}).get('expected_start') == validation.NOTIFICATIONS
            and claim.get('request', {}).get('target') == validation.DELIVERY,
            'claim6_identity_mismatch')
    import record_reconciliation as reconciliation
    binding = reconciliation.load_preparation()
    reconciliation.check_preserved(root, binding)
    reconciliation.check_failure(root, authority)
    # Recheck after reading exact bytes so a concurrent successor blocks the probe.
    require(authority._previous(root, 'testing') == {'sequence': 6, 'sha256': CLAIM_HASH},
            'claim6_identity_mismatch')

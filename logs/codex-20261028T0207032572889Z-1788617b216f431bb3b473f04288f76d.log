        self.proxy = connection.connection
        self.dbapi = self.proxy.dbapi_connection
        self.driver = self.proxy.driver_connection
        self.pgconn = self.driver.pgconn
        self.backend = self.driver.info.backend_pid
        self.rollback_uncertain = False
        self.guard()

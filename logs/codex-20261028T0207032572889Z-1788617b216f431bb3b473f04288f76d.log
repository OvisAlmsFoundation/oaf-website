def classification(error, phase):
    if isinstance(error, Blocked):
        return error.code
    if type(error).__name__ == 'Blocked':
        return 'preparation_or_evidence_mismatch'
    if isinstance(error, config.MigrationError):
        return error.classification
    if isinstance(error, (KeyboardInterrupt, SystemExit)):
        return config.Failure.INTERRUPTED
    if phase == 'setup_rollback':
        return 'cleanup_unconfirmed'
    if phase == 'credential':
        return config.Failure.CREDENTIAL_UNAVAILABLE
    if phase == 'connection':
        return config.Failure.CONNECTION
    if getattr(getattr(error, 'orig', error), 'sqlstate', None):
        return config.database_failure(error)
    return 'unexpected_validation_error'

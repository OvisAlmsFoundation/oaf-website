def test_missing_or_corrupt_required_evidence_prevents_delivery(app, client, admin, intake, change):
    assert client.post(URL, data=form()).status_code == 200
    with app.app_context():
        launch = db.session.get(Launch, web.IDENTITY)
        audit = db.session.get(AuditEvent, launch.last_audit_event_id)
        intent = Handoff.query.one()
        if change == "audit_json":
            audit.metadata_json = "[]"
        elif change == "audit_actor":
            audit.actor_user_id = None
        elif change in ("audit_snapshot", "prior"):
            metadata = json.loads(audit.metadata_json)
            if change == "audit_snapshot":
                metadata["new"]["status"] = "unapproved"
            else:
                metadata["prior"]["status"] = "approved"
            audit.metadata_json = json.dumps(metadata)
        elif change == "intent_missing":
            db.session.delete(intent)
        elif change == "payload":
            payload = json.loads(intent.payload_json)
            payload["release_url"] = "https://evil.example.org/"
            intent.payload_json = json.dumps(payload)
        elif change == "event_id":
            intent.event_id = "invalid"
        elif change == "original":
            audit.event_type = web.DOMAIN + ".corrected"
        else:
            db.session.rollback()
            with exclusive_schema_maintenance(db.engine), db.engine.begin() as connection:
                Launch.__table__.drop(connection)
        if change != "missing_table":
            db.session.commit()
    try:
        assert state(app)["state"] == "unavailable"
        if change != "missing_table":
            assert deliver(app) == 0 and not intake.calls
    finally:
        if change == "missing_table":
            with app.app_context(), exclusive_schema_maintenance(db.engine), db.engine.begin() as connection:
                Launch.__table__.create(connection)

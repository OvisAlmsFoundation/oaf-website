def test_uncertain_provider_retained_across_restart_without_blind_resend(app, client, admin, bridge):
    pipe, transport = bridge
    approve(client)
    scheduler(app)
    answer = pipe.call('process', outcome='uncertain')
    assert answer['processed'] == 1 and answer['delivery_statuses'] == ['uncertain']
    pipe.restart()
    pipe.call('elapse', values={'days':1})
    answer = pipe.call('process')
    assert answer['processed'] == 0 and len(answer['provider_calls']) == 1 and answer['attempts'] == 1
    assert answer['event_statuses'] == ['attention']

+++ b/.pytest_cache/wu2-connected-20261027T233203Z-ff7b89a7/test_web_connected.py
@@ -0,0 +1,162 @@
+"""WU2 seams using accepted WU1 transport and GraManna WU2 fixture interface."""
+from datetime import datetime, timedelta, timezone
+import json
+
+import pytest
+from sqlalchemy import update
+from app.extensions import db
+from app.models import AuditEvent, MobileReleaseHandoff as Handoff, WebApplicationLaunch as Launch
+from tests import test_web_launch as fixture
+from test_connected import bridge, admin, _push_request_context, approve, scheduler, rows, deliver, due
+
+WEB_URL = 'https://gramanna.example.org/app'
+HEADERS = {'Authorization': 'Bearer ' + 'c'*64, 'Content-Type': 'application/json'}
+
+
+@pytest.fixture
+def web_bridge(app, bridge, monkeypatch):
+    # Reuse accepted evidence shape, form, route and lifecycle helpers. Only the
+    # test destination and matching synthetic environment are injected.
+    monkeypatch.setattr(fixture, 'PUBLIC', WEB_URL)
+    fixture.settings(app)
+    settings = app.config['WEB_LAUNCH_ENVIRONMENTS'].pop('testing')
+    for evidence in settings['evidence'].values():
+        evidence['environment'] = 'development'
+        assert evidence['public_url'] == WEB_URL
+    app.config['WEB_LAUNCH_ENVIRONMENTS']['development'] = settings
+    return bridge
+
+
+def web_approve(client, version=0, action='approved'):
+    reply = client.post(fixture.URL, data=fixture.form(version, action))
+    assert reply.status_code == 200
+
+
+def test_web_atomic_handoff_three_platforms_and_exact_eligible_audience(app, client, admin, web_bridge, monkeypatch):
+    pipe, transport = web_bridge
+    # One representative accepted atomic rollback check, now connected to OAF.
+    with monkeypatch.context() as patch:
+        fixture.test_required_audit_and_outbox_failures_roll_back_authority_together(
+            app, client, admin, patch, 'outbox')
+    assert pipe.call('status')['events'] == 0 and not transport.calls
+    web_approve(client)
+    pending = rows(app)
+    assert len(pending) == 1 and pending[0]['attempts'] == 0 and not transport.calls
+    original = pending[0]
+    assert original['state'] == 'pending' and original['original'] == original['audit']
+    payload = original['payload']
+    assert set(payload) == {'event_id', 'source_approval_id', 'environment', 'platform', 'release_id',
+        'release_url', 'approved_at', 'audience_cutoff', 'content_version'}
+    assert (payload['platform'], payload['release_id'], payload['content_version'], payload['release_url']) == (
+        'web', 'gramanna-web', 'web-launch-v1', WEB_URL)
+    assert payload['approved_at'] == payload['audience_cutoff']
+    with app.app_context():
+        launch = db.session.get(Launch, fixture.web.IDENTITY)
+        audit = db.session.get(AuditEvent, launch.last_audit_event_id)
+        assert launch.approved_by_user_id == launch.verified_by_user_id == audit.actor_user_id == admin.id
+        assert launch.approved_at == launch.verified_at == audit.occurred_at
+        assert json.loads(audit.metadata_json)['new'] == fixture.web._snapshot(launch)
+    assert client.post(fixture.URL, data=fixture.form()).status_code == 409
+    approve(client); approve(client, 'ios')
+    scheduler(app)
+    assert len({r['event_id'] for r in rows(app)}) == 3
+    assert {r['state'] for r in rows(app)} == {'accepted'}
+    accepted = pipe.call('status')
+    assert accepted['platforms'] == ['android', 'ios', 'web'] and accepted['attempts'] == 0
+    stored = next(r for r in accepted['event_details'] if r['platform'] == 'web')
+    assert stored['release_url'] == WEB_URL and stored['event_id'] == payload['event_id']
+    processed = pipe.call('process')
+    assert processed['processor_status'] == 'processed' and processed['processed'] == 3
+    assert processed['delivery_statuses'] == ['accepted'] * 3
+    assert {(r['recipient_fixture'], r['platform']) for r in processed['provider_calls']} == {
+        (1, 'android'), (2, 'ios'), (6, 'web')}
+    assert processed['attempts'] == 3
+    scheduler(app)
+    assert pipe.call('process')['processed'] == 0 and len(transport.calls) == 3
+
+
+def test_web_authenticated_exact_url_identity_and_environment_contract(app, client, admin, web_bridge):
+    pipe, transport = web_bridge
+    web_approve(client)
+    raw = rows(app)[0]['raw']
+    for key in ('a'*64, 'b'*64, 'd'*64, ''):
+        reply = pipe.call('accept', headers=dict(HEADERS, Authorization='Bearer ' + key), body=raw)
+        assert reply['status_code'] == 401 and reply['events'] == 0
+    for change in (dict(environment='testing'), dict(platform='Web'), dict(release_id='other'),
+                   dict(content_version='mobile-launch-v1'), dict(release_url=WEB_URL + '/'),
+                   dict(release_url='https://other.example.org/app'), dict(recipients=[]), dict(subject='caller copy')):
+        reply = pipe.call('accept', headers=HEADERS, body=json.dumps(dict(json.loads(raw), **change)))
+        assert reply['status_code'] == 400 and reply['events'] == 0
+    scheduler(app)
+    assert pipe.call('status')['events'] == 1 and rows(app)[0]['state'] == 'accepted'
+    assert len(transport.calls) == 1
+
+
+def test_web_lost_response_successor_order_exact_replay_restart_and_lease_recovery(app, client, admin, web_bridge):
+    pipe, transport = web_bridge
+    web_approve(client)
+    transport.lose = True
+    assert deliver(app) == 1 and rows(app)[0]['state'] == 'uncertain'
+    original = rows(app)[0]
+    accepted = pipe.call('status')['event_details'][0]
+    web_approve(client, 1, 'corrected')
+    assert deliver(app) == 0
+    pipe.restart()
+    with app.app_context():
+        db.session.execute(update(Handoff).where(Handoff.id == original['id']).values(
+            state='in_flight', lease_until=datetime.utcnow()-timedelta(seconds=1),
+            next_attempt_at=datetime.utcnow()-timedelta(seconds=1), claim_token='f'*32))
+        db.session.commit(); db.session.remove()
+    scheduler(app)
+    history = rows(app)
+    assert {r['state'] for r in history} == {'accepted'}
+    assert transport.calls[:2] == [original['raw'].encode()] * 2 and len(transport.calls) == 3
+    assert len({r['payload']['audience_cutoff'] for r in history}) == 1
+    state = pipe.call('status')
+    assert state['events'] == 1 and state['revisions'] == 1
+    assert state['event_details'][0] == accepted
+    assert state['revision_sources'] == [history[1]['source']]
+    assert pipe.call('process')['processed'] == 1
+    pipe.restart()
+    final = pipe.call('process')
+    assert final['processed'] == 0 and final['attempts'] == 1
+
+
+def test_web_correction_original_cutoff_and_terminal_withdrawal_suppress_claimed_work(app, client, admin, web_bridge):
+    pipe, transport = web_bridge
+    web_approve(client); scheduler(app)
+    initial = rows(app)[0]
+    before = pipe.call('status')['event_details'][0]
+    web_approve(client, 1, 'corrected'); scheduler(app)
+    assert pipe.call('status')['revision_sources'] == [rows(app)[1]['source']]
+    assert pipe.call('prepare', event_id=initial['event_id'], claim=True)['delivery_statuses'] == ['claimed']
+    web_approve(client, 2, 'withdrawn'); scheduler(app)
+    history = rows(app)
+    assert len({r['event_id'] for r in history}) == len({r['payload']['audience_cutoff'] for r in history}) == 1
+    assert client.post(fixture.URL, data=fixture.form(3)).status_code == 409
+    replay = pipe.call('accept', headers=HEADERS, body=initial['raw'])
+    assert replay['status_code'] == 200 and replay['events'] == 1 and replay['revisions'] == 2
+    changed_cutoff = dict(initial['payload'], audience_cutoff=(datetime.fromisoformat(
+        initial['payload']['audience_cutoff'].replace('Z', '+00:00')) + timedelta(seconds=1)).isoformat())
+    assert pipe.call('accept', headers=HEADERS, body=json.dumps(changed_cutoff))['status_code'] == 409
+    pipe.restart()
+    state = pipe.call('process')
+    assert state['processed'] == 0 and state['delivery_statuses'] == ['suppressed']
+    assert state['event_details'][0] == before and not state['provider_calls']
+
+
+def test_web_retry_then_provider_uncertainty_survives_restart_without_blind_resend(app, client, admin, web_bridge):
+    pipe, transport = web_bridge
+    web_approve(client); scheduler(app)
+    original = pipe.call('status')['event_details'][0]
+    retry = pipe.call('process', outcome='retryable')
+    assert retry['processed'] == 1 and retry['delivery_statuses'] == ['failed']
+    assert pipe.call('process')['processed'] == 0
+    pipe.call('elapse', values={'seconds': 60})
+    uncertain = pipe.call('process', outcome='uncertain')
+    assert uncertain['processed'] == 1 and uncertain['delivery_statuses'] == ['uncertain']
+    pipe.restart()
+    pipe.call('elapse', values={'days': 1})
+    final = pipe.call('process')
+    assert final['processed'] == 0 and final['attempts'] == 2 and len(final['provider_calls']) == 2
+    assert final['event_statuses'] == ['attention'] and final['event_details'][0] == original

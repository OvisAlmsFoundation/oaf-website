    def request(self, method, url, **kwargs):
        self.calls.append((method, url, kwargs))
        payload = json.loads(kwargs["data"])
        assert method == "POST" and url == "https://oaf.example.org/api/integrations/v1/release-events"
        assert kwargs["headers"]["Authorization"] == "Bearer " + "c" * 64
        assert kwargs["allow_redirects"] is False and kwargs["stream"] is True
        assert kwargs["timeout"] == (3.05, 5) and len(kwargs["data"]) <= 1024
        assert payload["environment"] == "testing" and payload["content_version"] == (
            "web-launch-v1" if payload["platform"] == "web" else "mobile-launch-v1")
        assert str(UUID(payload["event_id"])) == payload["event_id"]
        assert str(UUID(payload["source_approval_id"])) == payload["source_approval_id"]
        if self.failure and not self.accept_before_failure:
            if isinstance(self.failure, Exception):
                raise self.failure
            return self.failure
        identity = payload["event_id"]
        if "action" in payload:
            old = self.events[identity]
            if payload["source_approval_id"] in self.revisions:
                assert self.revisions[payload["source_approval_id"]] == kwargs["data"]
            else:
                assert old["source_approval_id"] == payload["previous_approval_id"]
                assert old["audience_cutoff"] == payload["audience_cutoff"]
                assert old["approved_at"] < payload["approved_at"]
                self.revisions[payload["source_approval_id"]] = kwargs["data"]
                self.events[identity] = payload
        elif identity in self.events:
            assert self.events[identity] == payload
        else:
            assert not any(p["platform"] == payload["platform"] for p in self.events.values())
            self.events[identity] = payload
        if self.failure:
            raise self.failure
        return Response({"status": "accepted", "event_id": identity})

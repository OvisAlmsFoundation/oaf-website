    assert history[1]['payload']['release_url'] == 'https://apps.apple.com/app/id123456'
    accepted = pipe.call('status')
    assert accepted['events'] == 2 and accepted['attempts'] == 0 and not accepted['provider_calls']
    # A fresh OAF process reconstructs existing synthetic fixture persistence.
    pipe.restart()
    processed = pipe.call('process')
    assert processed['processor_status'] == 'processed' and processed['processed'] == 2
    assert processed['delivery_statuses'] == ['accepted', 'accepted']
    assert {(r['recipient_fixture'], r['platform']) for r in processed['provider_calls']} == {(1, 'android'), (2, 'ios')}

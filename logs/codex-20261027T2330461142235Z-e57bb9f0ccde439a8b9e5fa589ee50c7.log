def test_lost_response_exact_replay_deduplication_and_expired_worker_lease(app, client, admin, bridge):
    pipe, transport = bridge
    approve(client)
    transport.lose = True
    assert deliver(app) == 1 and rows(app)[0]['state'] == 'uncertain'
    original = rows(app)[0]['raw'].encode()
    assert deliver(app) == 0 and pipe.call('status')['events'] == 1
    pipe.restart()
    # Recreate expired in-flight state using the existing test-owned outbox.
    with app.app_context():
        db.session.execute(update(Handoff).values(state='in_flight', lease_until=datetime.utcnow()-timedelta(seconds=1),
            next_attempt_at=datetime.utcnow()-timedelta(seconds=1), claim_token='f'*32))
        db.session.commit()
        db.session.remove()
    scheduler(app)
    assert rows(app)[0]['state'] == 'accepted'
    assert transport.calls == [original, original]
    assert pipe.call('status')['events'] == 1
    assert pipe.call('process')['processed'] == 1
    pipe.restart()
    final = pipe.call('process')
    assert final['processed'] == 0 and final['attempts'] == 1

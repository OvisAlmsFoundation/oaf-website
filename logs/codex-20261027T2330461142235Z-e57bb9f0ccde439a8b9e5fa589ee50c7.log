def test_concurrent_and_stale_approval_has_one_winner(app, client, admin):
    clients, barrier, results = [app.test_client(), app.test_client()], Barrier(2), []
    for candidate in clients:
        sign_in(candidate, admin)
    def compete(candidate):
        barrier.wait(timeout=10)
        results.append(candidate.post(URL, data=form()).status_code)
    threads = [Thread(target=compete, args=(candidate,)) for candidate in clients]
    for thread in threads:
        thread.start()
    for thread in threads:
        thread.join(20)
    assert all(not thread.is_alive() for thread in threads) and sorted(results) == [200, 409]
    assert client.post(URL, data=form()).status_code == 409 and len(rows(app)) == 1

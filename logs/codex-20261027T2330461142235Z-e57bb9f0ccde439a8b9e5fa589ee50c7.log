        intent = Handoff.query.order_by(Handoff.id.desc()).first()
        if corruption == "original":
            intent.platform = "ios"
        elif corruption == "predecessor":
            intent.predecessor_id = intent.id
        elif corruption == "predecessor_action":
            payload = json.loads(intent.payload_json)
            del payload["action"]
            intent.payload_json = json.dumps(payload)
        elif corruption == "reason":
            metadata["reason_reference"] = None
        elif corruption == "withdrawal":
            metadata["prior"]["public_url"] = "https://other.example.org/"
        elif corruption == "approval":
            stamp = launch.approved_at - timedelta(seconds=1)
            db.session.execute(update(Launch).values(approved_at=stamp, verified_at=stamp)
                .execution_options(synchronize_session=False))
            metadata["new"].update(approved_at=stamp.isoformat() + "Z", verified_at=stamp.isoformat() + "Z")
        else:
            audit.prior_audit_event_id = audit.id
            audit.event_type, audit.reason_code = web.DOMAIN + ".corrected", "web_launch_corrected"
            metadata.update(action="corrected", prior_audit_event_id=audit.id)
            metadata["prior"]["status"] = "approved"
        audit.metadata_json = json.dumps(metadata)
        db.session.commit()
    assert state(app)["state"] == "unavailable"
    previous_calls = len(intake.calls)
    assert deliver(app) == 0 and len(intake.calls) == previous_calls

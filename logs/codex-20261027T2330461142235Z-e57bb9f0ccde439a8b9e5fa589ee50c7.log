def _evidence(reference, revision, at, url):
    settings = _settings()
    evidence = settings.get("evidence", {}).get(reference)
    if (not _reference(reference, "evidence") or not isinstance(evidence, dict)
            or set(evidence) != {"release_id", "environment", "public_url", "revision", "control_reference", "readiness_reference", "checked_at", "expires_at"}
            or evidence["release_id"] != IDENTITY or evidence["environment"] != handoff.environment()
            or evidence["public_url"] != settings["canonical_url"] or url != settings["canonical_url"]
            or type(evidence["revision"]) is not int or evidence["revision"] != revision
            or not _reference(evidence["control_reference"], "control")
            or not _reference(evidence["readiness_reference"], "readiness")
            or not _utc(evidence["checked_at"]) <= at <= _utc(evidence["expires_at"])):
        raise ValueError("Current, revision-bound URL-control and launch-readiness evidence is required.")
    return json.dumps(evidence, sort_keys=True, separators=(",", ":"))

def test_android_ios_authenticated_acceptance_eligibility_and_automatic_processing(app, client, admin, bridge):
    pipe, transport = bridge
    approve(client)
    pending = rows(app)
    assert len(pending) == 1 and not transport.calls
    scheduler(app)
    assert rows(app)[0]['state'] == 'accepted'
    assert pipe.call('status')['platforms'] == ['android']
    approve(client, 'ios')
    scheduler(app)
    history = rows(app)
    assert len({r['event_id'] for r in history}) == 2
    assert {r['state'] for r in history} == {'accepted'}
    assert history[1]['payload']['release_id'] == '123456'
    assert history[1]['payload']['release_url'] == 'https://apps.apple.com/app/id123456'
    accepted = pipe.call('status')
    assert accepted['events'] == 2 and accepted['attempts'] == 0 and not accepted['provider_calls']
    # A fresh OAF process reconstructs existing synthetic fixture persistence.
    pipe.restart()
    processed = pipe.call('process')
    assert processed['processor_status'] == 'processed' and processed['processed'] == 2
    assert processed['delivery_statuses'] == ['accepted', 'accepted']
    assert {(r['recipient_fixture'], r['platform']) for r in processed['provider_calls']} == {(1, 'android'), (2, 'ios')}
    assert processed['attempts'] == 2
    scheduler(app)
    assert pipe.call('process')['processed'] == 0 and len(transport.calls) == 2

def _utc(value):
    if not isinstance(value, str) or not value.endswith("Z"):
        raise ValueError("Evidence requires an explicit UTC timestamp.")
    stamp = datetime.fromisoformat(value[:-1])
    if stamp.tzinfo is not None:
        raise ValueError("Evidence requires an explicit UTC timestamp.")
    return stamp

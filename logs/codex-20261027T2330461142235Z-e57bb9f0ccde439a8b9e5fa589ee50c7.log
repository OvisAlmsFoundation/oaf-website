def _apply_sqlite_test_connection_contract(dbapi_connection):
    cursor = dbapi_connection.cursor()
    try:
        cursor.execute("PRAGMA foreign_keys=ON")
        # CHECK bypass is connection-local and survives commit/pool return.
        # Reset every checkout, including connections left by legacy row seeds.
        cursor.execute("PRAGMA ignore_check_constraints=OFF")
        cursor.execute(f"PRAGMA busy_timeout={SQLITE_TEST_BUSY_TIMEOUT_MS}")
        cursor.execute("PRAGMA synchronous=NORMAL")
        cursor.execute("PRAGMA temp_store=MEMORY")
    finally:
        cursor.close()
    dbapi_connection.isolation_level = "IMMEDIATE"

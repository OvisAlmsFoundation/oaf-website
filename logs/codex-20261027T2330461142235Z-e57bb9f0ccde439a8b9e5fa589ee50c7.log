+    (17480, 'continuation-native-exit.json', 'connected-continuation.log', 1, 1),
+    (15796, 'provider-continuation-native-exit.json', 'connected-provider-continuation.log', 1, 0),
+)
+for pid, native_file, log, pass_count, fail_count in attempt_specs:
+    receipt = read(f'validation-receipt-{pid}.json')
+    native = read(native_file)
+    xml_name = f'connected-results-{pid}.xml'
+    xml = ET.parse(OUT / xml_name).getroot()
+    cases = xml.findall('.//testcase')
+    failures = [case for case in cases if case.find('failure') is not None or case.find('error') is not None]
+    passes = [case for case in cases if case not in failures]
+    assert len(passes) == pass_count and len(failures) == fail_count
+    assert receipt['pytest_exit'] == native['native_exit'] == (1 if fail_count else 0)
+    assert receipt['unexpected_external_access'] == 0 and all(code == 0 for code in receipt['child_exits'])
+    guard_exits.extend(receipt['child_exits'])

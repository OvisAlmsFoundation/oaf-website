def test_environment_authentication_and_default_off_isolation(app, client, admin, bridge):
    pipe, transport = bridge
    approve(client)
    raw = rows(app)[0]['raw']
    before = pipe.call('status')
    for key in ('a'*64, 'b'*64, 'd'*64, ''):
        reply = pipe.call('accept', headers={'Authorization':'Bearer '+key, 'Content-Type':'application/json'}, body=raw)
        assert reply['status_code'] == 401 and reply['events'] == 0
    payload = json.loads(raw)
    payload['environment'] = 'testing'
    assert pipe.call('accept', headers={'Authorization':'Bearer '+'c'*64, 'Content-Type':'application/json'},
        body=json.dumps(payload))['status_code'] == 400
    app.config['OAF_RELEASE_HANDOFF_ENABLED'] = False
    assert deliver(app) == 0 and not transport.calls
    app.config['OAF_RELEASE_HANDOFF_ENABLED'] = True
    app.config['OAF_INTEGRATION_ENVIRONMENT'] = 'testing'
    assert deliver(app) == 0 and not transport.calls
    assert pipe.call('status')['events'] == before['events'] == 0

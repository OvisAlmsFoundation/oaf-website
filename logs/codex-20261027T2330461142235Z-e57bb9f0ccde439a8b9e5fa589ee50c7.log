    assert change(client, 1, 'withdrawn', platform='ios').status_code == 200
    assert deliver(app) == 1
    state = pipe.call('status')
    assert state['events'] == 2 and state['revisions'] == 2 and state['delivery_statuses'] == ['suppressed']
    answer = pipe.call('process')
    assert answer['processed'] == 1 and answer['provider_calls'] == [dict(recipient_fixture=1, platform='android', corrected_url=True)]
    # Old initial approval replay cannot reactivate withdrawn iOS.
    initial = next(raw for raw in transport.calls if json.loads(raw)['platform'] == 'ios' and 'action' not in json.loads(raw))
    assert pipe.call('accept', headers={'Authorization':'Bearer '+'c'*64, 'Content-Type':'application/json'},
        body=initial.decode())['status_code'] == 200
    assert pipe.call('process')['processed'] == 0

@pytest.mark.parametrize("method", ["get", "post"])
def test_existing_admin_authorization_and_session_checks(app, client, create_user, authority, expected, method):
    if authority != "anonymous":
        user = create_user(is_admin=authority != "non_admin")
        sign_in(client, user)
        if authority in ("closed", "stale", "deleted"):
            with app.app_context():
                actor = db.session.get(User, user.id)
                if authority == "closed":
                    actor.account_status = "closed_pending_purge"
                elif authority == "stale":
                    actor.session_version += 1
                else:
                    db.session.delete(actor)
                db.session.commit()
        elif authority == "idle":
            with client.session_transaction() as cookie:
                cookie["last_activity"] = (datetime.utcnow() - timedelta(hours=1)).isoformat()
    assert getattr(client, method)(URL, **({"data": form()} if method == "post" else {})).status_code == expected
    assert not rows(app)

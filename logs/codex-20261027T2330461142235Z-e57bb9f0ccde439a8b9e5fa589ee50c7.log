def capture(root):
    def git(*args):
        return subprocess.check_output(['git', '--no-optional-locks', '-c', 'safe.directory=' + str(root), *args], cwd=root)
    files = git('ls-files', '--cached', '--others', '--exclude-standard', '-z').decode().split('\0')
    forbidden = {'.env', 'credentials', '.pgpass', 'pgpass.conf'}
    hashes = {}
    for name in files:
        if not name:
            continue
        path = root / name
        assert not any(part.lower() in {'secrets', '.aws', '.ssh'} for part in path.parts)
        assert path.name not in forbidden and not path.name.startswith('.env.')
        if path.is_file():
            hashes[name] = hashlib.sha256(path.read_bytes()).hexdigest()
    return dict(head=git('rev-parse', 'HEAD').decode().strip(),
                index=hashlib.sha256((root / '.git/index').read_bytes()).hexdigest(),
                status=git('status', '--short', '--untracked-files=all').decode(), hashes=hashes)

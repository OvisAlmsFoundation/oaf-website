def _settings():
    settings = current_app.config.get("WEB_LAUNCH_ENVIRONMENTS", {}).get(handoff.environment(), {})
    url = settings.get("canonical_url")
    if not isinstance(url, str) or not 1 <= len(url) <= 512 or not url.isascii() or any(ord(c) <= 32 or ord(c) == 127 for c in url) or any(c in url for c in "?#%\\"):
        raise ValueError("A trusted canonical public HTTPS URL is required.")
    parsed = urlsplit(url)
    host = parsed.hostname or ""
    if (parsed.scheme != "https" or not url.startswith("https://") or parsed.netloc != host
            or re.fullmatch(r"(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}", host) is None
            or host.rsplit(".", 1)[-1] in ("localhost", "local", "internal", "test", "invalid", "example", "lan", "home", "arpa", "onion")
            or host in ("play.google.com", "apps.apple.com") or parsed.path.startswith("//")
            or any(p in (".", "..") for p in parsed.path.split("/"))):
        raise ValueError("A trusted canonical public HTTPS URL is required.")
    return settings

+"""WU1 read-only receipts, narrowed to OAF and the reused GraManna interface."""
+from datetime import datetime, timezone
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+OUT = Path(__file__).resolve().parent
+ROOT = OUT.parents[1]
+GRAM = ROOT.parent / 'GraManna'
+BASE = ROOT / '.pytest_cache/wu1-connected-20261027T033228Z-2573aadb'
+DEPENDENCIES = (
+    'tests/conftest.py', 'tests/test_web_launch.py', 'tests/test_mobile_release_governance.py',
+    'tests/test_mobile_release_handoff.py', 'tests/test_oaf_shared_services.py',
+    'app/services/web_launch_service.py', 'app/services/mobile_release_handoff.py',
+    'app/services/mobile_release_service.py', 'app/models.py', '.pytest.ini',
+)
+
+def git(root, *args):
+    return subprocess.check_output(['git', '--no-optional-locks', '-c', 'safe.directory=' + str(root), *args], cwd=root)
+
+def hashes(root, names):
+    answer = {}
+    for name in names:
+        if not name:
+            continue
+        path = root / name
+        assert not any(part.lower() in {'secrets', '.aws', '.ssh'} for part in path.parts)
+        assert not path.name.startswith('.env') and path.name not in {'credentials', '.pgpass', 'pgpass.conf'}
+        if path.is_file():
+            answer[name.replace('\\', '/')] = hashlib.sha256(path.read_bytes()).hexdigest()
+    return answer
+
+def tree(root):
+    return hashes(root, [str(path.relative_to(root)) for path in root.rglob('*') if path.is_file()])
+
+mode = sys.argv[1]
+files = git(ROOT, 'ls-files', '--cached', '--others', '--exclude-standard', '-z').decode().split('\0')
+# Invoke-OAFCodex owns its active transcript; retain its Git identity, without
+# treating expected outer reporting appends as source mutations.
+source = [name for name in files if not name.startswith('logs/')]
+record = dict(utc=datetime.now(timezone.utc).isoformat(),
+    oaf=dict(head=git(ROOT, 'rev-parse', 'HEAD').decode().strip(),
+             index=hashlib.sha256((ROOT / '.git/index').read_bytes()).hexdigest(),
+             status=git(ROOT, 'status', '--short', '--untracked-files=all').decode(),
+             hashes=hashes(ROOT, source)),
+    gramanna=dict(head=git(GRAM, 'rev-parse', 'HEAD').decode().strip(),
+                  index=hashlib.sha256((GRAM / '.git/index').read_bytes()).hexdigest(),
+                  hashes=hashes(GRAM, DEPENDENCIES)),
+    wu1=tree(BASE),
+    migrations={name: tree(ROOT / '.pytest_cache' / name) for name in
+                ('wu2-testing-0008-v1', 'wu2-development-0008-v1', 'wu2-approve-0008-20261027T213857Z-48b43953')})
+if mode == 'after':
+    before = json.loads((OUT / 'before.json').read_text(encoding='utf-8'))
+    record['preserved'] = all(record[key] == before[key] for key in ('oaf', 'gramanna', 'wu1', 'migrations'))
+with (OUT / (mode + '.json')).open('x', encoding='utf-8') as stream:
+    json.dump(record, stream, indent=2); stream.flush(); os.fsync(stream.fileno())
+print(json.dumps(dict(stage='preservation', status='PASS' if mode == 'before' or record['preserved'] else 'ERROR',
+    oaf_source_files=len(record['oaf']['hashes']), wu1_files=len(record['wu1']),
+    gramanna_interface_files=len(record['gramanna']['hashes']))), flush=True)
+if mode == 'after' and not record['preserved']:
+    raise SystemExit(1)

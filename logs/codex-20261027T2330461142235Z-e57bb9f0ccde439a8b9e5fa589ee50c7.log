    if corruption in ("predecessor", "predecessor_action", "reason", "withdrawal"):
        assert deliver(app) == 1
        assert client.post(URL, data=form(1, "withdrawn" if corruption == "withdrawal" else "corrected")).status_code == 200
    with app.app_context():

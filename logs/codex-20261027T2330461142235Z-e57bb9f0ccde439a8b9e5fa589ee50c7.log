def _establish_sqlite_wal_once(engine):
    with exclusive_schema_maintenance(engine), engine.connect() as connection:
        wal_connection = connection.execution_options(isolation_level="AUTOCOMMIT")
        journal_mode = wal_connection.exec_driver_sql("PRAGMA journal_mode=WAL").scalar_one()

for path in ['migrations/versions/0008_web_launch.py','migrations/versions/0007_release_approvals.py','oaf_website/web_launch_schema.py']:
    _,raw = obj(files[path]); work=(root/path).read_bytes()
    norm=lambda b:b.replace(b'\\r\\n',b'\\n').replace(b'\\r',b'\\n')

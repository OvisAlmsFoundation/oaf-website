    "digest_check": "claim_digest IS NULL OR claim_digest ~ '^[0-9a-f]{64}$'",
    "retry_check": "next_attempt_at IS NULL OR status IN ('pending','failed') AND attempts < 3",
    "accepted_check": "(status = 'accepted') = (accepted_at IS NOT NULL)",

import pathlib, zlib, hashlib, json
root = pathlib.Path.cwd()
commit = '5c4bba88064b50d9e717bc3e9a7ecf1cd59d6ce3'
def obj(oid):
    p = root / '.git' / 'objects' / oid[:2] / oid[2:]
    raw = zlib.decompress(p.read_bytes())
    assert hashlib.sha1(raw).hexdigest() == oid
    header, content = raw.split(b'\\0',1)
    kind, length = header.split(b' ')
    assert int(length) == len(content)
    return kind, content
kind, data = obj(commit)
assert kind == b'commit'
headers = data.split(b'\\n\\n',1)[0].splitlines()
print('COMMIT',commit)
print('\\n'.join(h.decode() for h in headers if h.startswith((b'tree ', b'parent '))))
tree = next(h[5:].decode() for h in headers if h.startswith(b'tree '))
files = {}
def walk(oid,prefix=''):
    kind,data = obj(oid)
    assert kind == b'tree'
    pos = 0
    while pos < len(data):
        end = data.index(b'\\0',pos)
        mode,name = data[pos:end].split(b' ',1)
        child = data[end+1:end+21].hex()
        name = prefix + name.decode()
        pos = end+21
        if mode == b'40000': walk(child,name+'/')
        else: files[name] = child
walk(tree)
path = 'migrations/manifest.json'
_, raw = obj(files[path]); manifest = json.loads(raw)
normalized = raw.replace(b'\\r\\n',b'\\n').replace(b'\\r',b'\\n')
print('MANIFEST_BLOB',files[path]); print('MANIFEST_SHA256_UTF8_LF',hashlib.sha256(normalized).hexdigest())
for key,value in manifest.items():
    if isinstance(value,dict):

# Dedicated website Python environment
/.venv/

# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Local SQLite databases and sidecar files
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Local configuration and secrets; keep shareable templates
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template
/secrets/
/config/local/

# Generated development, packaging, and coverage artifacts
/instance/
/build/
/dist/
*.egg-info/
.coverage
.coverage.*
/htmlcov/
/coverage.xml
